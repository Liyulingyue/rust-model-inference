+static bool qwen3tts_trace_graph_tensor(
+        ggml_cgraph * graph,
+        const char * tensor_name,
+        const char * trace_name,
+        bool transpose) {
+    if (!std::getenv("QWEN3_TTS_ORACLE_TRACE")) {
+        return true;
+    }
+    ggml_tensor * tensor = ggml_graph_get_tensor(graph, tensor_name);
+    if (!tensor) {
+        return true;
+    }
+    if (tensor->type != GGML_TYPE_F32 || tensor->ne[2] != 1 || tensor->ne[3] != 1) {
+        return false;
+    }
+    const int64_t ne0 = tensor->ne[0];
+    const int64_t ne1 = tensor->ne[1];
+    std::vector<float> raw((size_t) ggml_nelements(tensor));
+    ggml_backend_tensor_get(tensor, raw.data(), 0, ggml_nbytes(tensor));
+    if (!transpose) {
+        return qwen3tts_trace_f32(trace_name, raw, { ne1, ne0 });
+    }
+    std::vector<float> values(raw.size());
+    for (int64_t row = 0; row < ne1; ++row) {
+        for (int64_t column = 0; column < ne0; ++column) {
+            values[(size_t) column * (size_t) ne1 + (size_t) row] =
+                raw[(size_t) row * (size_t) ne0 + (size_t) column];
+        }
+    }
+    return qwen3tts_trace_f32(trace_name, values, { ne0, ne1 });
+}
+
+static bool qwen3tts_trace_code2wav(ggml_cgraph * graph) {
+    return qwen3tts_trace_graph_tensor(graph, "wav_quant_hidden", "tts.rvq_hidden", false) &&
+           qwen3tts_trace_graph_tensor(graph, "wav_pre_conv_out", "tts.wav_pre_conv", true) &&
+           qwen3tts_trace_graph_tensor(graph, "wav_tfm_out", "tts.wav_tfm", false);
+}
