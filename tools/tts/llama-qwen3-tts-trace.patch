+#pragma once
+
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <vector>
+
+static inline bool qwen3tts_trace_raw(
+        const char * name,
+        const char * dtype,
+        const void * data,
+        size_t element_size,
+        size_t count,
+        const std::vector<int64_t> & shape) {
+    const char * directory = std::getenv("QWEN3_TTS_ORACLE_TRACE");
+    if (!directory) {
+        return true;
+    }
+    const std::string filename = std::string(name) + "." + dtype;
+    const std::string path = std::string(directory) + "/" + filename;
+    std::ofstream binary(path, std::ios::binary | std::ios::trunc);
+    binary.write(static_cast<const char *>(data), static_cast<std::streamsize>(element_size * count));
+    binary.close();
+    if (!binary) {
+        return false;
+    }
+    std::ofstream metadata(std::string(directory) + "/trace.jsonl", std::ios::app);
+    metadata << "{\"name\":\"" << name << "\",\"shape\":[";
+    for (size_t i = 0; i < shape.size(); ++i) {
+        if (i) {
+            metadata << ',';
+        }
+        metadata << shape[i];
+    }
+    metadata << "],\"dtype\":\"" << dtype << "\",\"path\":\"" << filename
+             << "\",\"count\":" << count << "}\n";
+    return metadata.good();
+}
+
+static inline bool qwen3tts_trace_f32(
+        const char * name,
+        const std::vector<float> & values,
+        const std::vector<int64_t> & shape) {
+    return qwen3tts_trace_raw(name, "f32", values.data(), sizeof(float), values.size(), shape);
+}
+
+static inline bool qwen3tts_trace_i32(
+        const char * name,
+        const std::vector<int32_t> & values,
+        const std::vector<int64_t> & shape) {
+    return qwen3tts_trace_raw(name, "i32", values.data(), sizeof(int32_t), values.size(), shape);
+}
