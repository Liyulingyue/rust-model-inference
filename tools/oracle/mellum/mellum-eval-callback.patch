+        if (tensor->type != GGML_TYPE_F32 && tensor->type != GGML_TYPE_I32) {
+            throw std::runtime_error(std::string("selected tensor has unexpected type: ") + tensor->name);
+        }
+        std::vector<uint8_t> bytes(ggml_nbytes(tensor));
+        ggml_backend_tensor_get(tensor, bytes.data(), 0, bytes.size());
+
+        tensor_snapshot snapshot;
+        std::copy(tensor->ne, tensor->ne + GGML_MAX_DIMS, snapshot.ne.begin());
+        if (tensor->type == GGML_TYPE_I32) {
+            const size_t count = ggml_nelements(tensor);
+            snapshot.ints.resize(count);
+            std::memcpy(snapshot.ints.data(), bytes.data(), count * sizeof(int32_t));
+            tensors_[tensor->name] = std::move(snapshot);
+            return;
+        }
+        snapshot.values.reserve(ggml_nelements(tensor));
+        for (int64_t i3 = 0; i3 < tensor->ne[3]; ++i3) {
+            for (int64_t i2 = 0; i2 < tensor->ne[2]; ++i2) {
