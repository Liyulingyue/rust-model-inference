+// Standalone Qwen-Image-2.1 DiT oracle harness: loads the diffusion GGUF,
+// runs a single model forward on deterministic synthetic inputs, and traces
+// intermediate checkpoints when QWEN_IMAGE_2_1_ORACLE_TRACE is set.
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "ggml-cpu.h"
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include "model/diffusion/qwen_image_2_1.hpp"
+#include "model_loader.h"
+#include "qwen_image_2_1_trace.hpp"
+#include "stable-diffusion.h"
+
+namespace {
+
+void harness_log(enum sd_log_level_t level, const char* text, void*) {
+    static const char* prefixes[] = { "[DEBUG]", "[VERBOSE]", "[INFO]", "[WARN]", "[ERROR]" };
+    size_t index = level <= SD_LOG_ERROR ? (size_t)level : (size_t)SD_LOG_ERROR;
+    fprintf(level >= SD_LOG_ERROR ? stderr : stdout, "%s %s", prefixes[index], text);
+}
+
+struct HarnessOptions {
+    std::string diffusion_model;
+    int threads        = 1;
+    int64_t latent_w   = 16;
+    int64_t latent_h   = 16;
+    int64_t context_len = 128;
+    float timestep     = 500.0f;
+    uint32_t seed      = 1234567u;
+};
+
+uint32_t next_random(uint32_t& state) {
+    state = state * 1664525u + 1013904223u;
+    return state;
+}
+
+// Deterministic values in [-1, 1) with exact float construction on both sides
+// of the parity check.
+float next_value(uint32_t& state) {
+    uint32_t word = next_random(state);
+    uint32_t mantissa = (word >> 8) & 0xFFFF;
+    return static_cast<float>(mantissa) / 32768.0f - 1.0f;
+}
+
+// Minimal GGUF v3 reader: maps the data section and resolves tensor byte
+// offsets so the harness can feed params without the ModelManager pipeline.
+struct RawGguf {
+    const uint8_t* base = nullptr;
+    size_t size = 0;
+    struct TensorBytes {
+        const uint8_t* data;
+        size_t bytes;
+        ggml_type type;
+        int64_t ne[4];
+    };
+    std::map<std::string, TensorBytes> tensors;
+};
+
+bool read_string(const uint8_t* data, size_t size, size_t& pos, std::string& out) {
+    uint64_t length = 0;
+    if (pos > size || size - pos < sizeof(length)) return false;
+    std::memcpy(&length, data + pos, sizeof(length));
+    pos += sizeof(length);
+    if (length > size - pos) return false;
+    const size_t string_length = static_cast<size_t>(length);
+    out.assign(reinterpret_cast<const char*>(data) + pos, string_length);
+    pos += string_length;
+    return true;
+}
+
+bool load_raw_gguf(const std::string& path, RawGguf& gguf) {
+    int fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0) return false;
+    struct stat st;
+    if (fstat(fd, &st) != 0) {
+        close(fd);
+        return false;
+    }
+    gguf.size = static_cast<size_t>(st.st_size);
+    void* mapped = mmap(nullptr, gguf.size, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+    if (mapped == MAP_FAILED) return false;
+    gguf.base = static_cast<const uint8_t*>(mapped);
+
+    const uint8_t* data = gguf.base;
+    size_t pos = 0;
+    uint32_t magic = 0, version = 0;
+    uint64_t tensor_count = 0, kv_count = 0;
+    if (pos > gguf.size || gguf.size - pos < 4) return false;
+    std::memcpy(&magic, data + pos, 4);
+    pos += 4;
+    if (magic != 0x46554747u) return false;  // "GGUF" little endian
+    if (gguf.size - pos < 4 + sizeof(uint64_t) + sizeof(uint64_t)) return false;
+    std::memcpy(&version, data + pos, 4);
+    pos += 4;
+    if (version < 2 || version > 3) return false;
+    std::memcpy(&tensor_count, data + pos, 8);
+    pos += 8;
+    std::memcpy(&kv_count, data + pos, 8);
+    pos += 8;
+
+    auto skip_scalar = [&](uint32_t type) -> bool {
+        size_t width = 0;
+        switch (type) {
+            case 0:  // UINT8
+            case 1:  // INT8
+            case 7:  // BOOL
+                width = 1;
+                break;
+            case 2:  // UINT16
+            case 3:  // INT16
+                width = 2;
+                break;
+            case 4:  // UINT32
+            case 5:  // INT32
+            case 6:  // FLOAT32
+                width = 4;
+                break;
+            case 10:  // UINT64
+            case 11:  // INT64
+            case 12:  // FLOAT64
+                width = 8;
+                break;
+            default:
+                return false;
+        }
+        if (width > gguf.size - pos) return false;
+        pos += width;
+        return true;
+    };
+
+    // Skip key/value pairs (untagged GGUFs from this pipeline have none, but
+    // tolerate them to stay format-correct).
+    for (uint64_t i = 0; i < kv_count; ++i) {
+        std::string key;
+        if (!read_string(data, gguf.size, pos, key)) return false;
+        if (pos + 4 > gguf.size) return false;
+        uint32_t value_type = 0;
+        std::memcpy(&value_type, data + pos, 4);
+        pos += 4;
+        if (value_type == 8) {  // string
+            std::string unused;
+            if (!read_string(data, gguf.size, pos, unused)) return false;
+        } else if (value_type == 9) {  // array
+            if (pos + 8 > gguf.size) return false;
+            uint64_t count = 0;
+            std::memcpy(&count, data + pos, 8);
+            pos += 8;
+            uint32_t element_type = 0;
+            if (pos + 4 > gguf.size) return false;
+            std::memcpy(&element_type, data + pos, 4);
+            pos += 4;
+            for (uint64_t j = 0; j < count; ++j) {
+                if (element_type == 8) {
+                    std::string unused;
+                    if (!read_string(data, gguf.size, pos, unused)) return false;
+                } else if (!skip_scalar(element_type)) {
+                    return false;
+                }
+            }
+        } else if (value_type != 8 && value_type != 9) {
+            if (!skip_scalar(value_type)) return false;
+        } else {
+            return false;
+        }
+    }
+
+    struct Entry {
+        ggml_type type;
+        int64_t ne[4];
+        uint64_t offset;
+    };
+    std::map<std::string, Entry> entries;
+    for (uint64_t i = 0; i < tensor_count; ++i) {
+        std::string name;
+        if (!read_string(data, gguf.size, pos, name)) return false;
+        if (pos + 4 > gguf.size) return false;
+        uint32_t n_dims = 0;
+        std::memcpy(&n_dims, data + pos, 4);
+        pos += 4;
+        if (n_dims > 4) return false;
+        Entry entry{};
+        entry.ne[0] = entry.ne[1] = entry.ne[2] = entry.ne[3] = 1;
+        for (uint32_t d = 0; d < n_dims; ++d) {
+            uint64_t dim = 0;
+            if (pos + 8 > gguf.size) return false;
+            std::memcpy(&dim, data + pos, 8);
+            pos += 8;
+            if (dim > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) return false;
+            entry.ne[d] = static_cast<int64_t>(dim);
+        }
+        uint32_t type = 0;
+        if (pos + 4 > gguf.size) return false;
+        std::memcpy(&type, data + pos, 4);
+        pos += 4;
+        entry.type = static_cast<ggml_type>(type);
+        if (pos + 8 > gguf.size) return false;
+        std::memcpy(&entry.offset, data + pos, 8);
+        pos += 8;
+        entries.emplace(name, entry);
+    }
+
+    if (pos > std::numeric_limits<size_t>::max() - 31) return false;
+    size_t data_section = (pos + 31) & ~static_cast<size_t>(31);
+    for (const auto& [name, entry] : entries) {
+        if (static_cast<uint32_t>(entry.type) >= GGML_TYPE_COUNT) return false;
+        size_t elements = 1;
+        for (int d = 0; d < 4; ++d) {
+            if (entry.ne[d] < 0) return false;
+            const uint64_t dimension = static_cast<uint64_t>(entry.ne[d]);
+            if (dimension > std::numeric_limits<size_t>::max()) return false;
+            const size_t dim = static_cast<size_t>(dimension);
+            if (dim != 0 && elements > std::numeric_limits<size_t>::max() / dim) return false;
+            elements *= dim;
+        }
+        const size_t block_size = ggml_blck_size(entry.type);
+        const size_t type_size = ggml_type_size(entry.type);
+        if (block_size == 0 || elements % block_size != 0) return false;
+        const size_t block_count = elements / block_size;
+        if (type_size != 0 && block_count > std::numeric_limits<size_t>::max() / type_size) return false;
+        const size_t bytes = block_count * type_size;
+        if (data_section > gguf.size || entry.offset > std::numeric_limits<size_t>::max() - data_section) return false;
+        const size_t tensor_start = data_section + static_cast<size_t>(entry.offset);
+        if (tensor_start > gguf.size || bytes > gguf.size - tensor_start) return false;
+        RawGguf::TensorBytes tensor_bytes;
+        tensor_bytes.data = gguf.base + data_section + entry.offset;
+        tensor_bytes.bytes = bytes;
+        tensor_bytes.type = entry.type;
+        tensor_bytes.ne[0] = entry.ne[0];
+        tensor_bytes.ne[1] = entry.ne[1];
+        tensor_bytes.ne[2] = entry.ne[2];
+        tensor_bytes.ne[3] = entry.ne[3];
+        gguf.tensors.emplace(name, tensor_bytes);
+    }
+    return true;
+}
+
+// The harness runs without a DeviceResidencyManager, so param tensors get
+// their data mapped directly from the GGUF file before compute. F32 params
+// stored as BF16 in the file are widened (exact, zero-extended mantissa).
+struct ConversionBuffers {
+    static std::vector<std::unique_ptr<float[]>>& get() {
+        static std::vector<std::unique_ptr<float[]>> buffers;
+        return buffers;
+    }
+};
+
+bool fill_params_from_gguf(Qwen::QwenImage21Runner& runner, const RawGguf& gguf) {
+    std::map<std::string, ggml_tensor*> params;
+    runner.get_param_tensors(params, "model.diffusion_model");
+    std::vector<std::unique_ptr<float[]>>& conversions = ConversionBuffers::get();
+    for (const auto& [name, tensor] : params) {
+        auto found = gguf.tensors.find(name);
+        if (found == gguf.tensors.end()) {
+            LOG_ERROR("gguf is missing tensor %s", name.c_str());
+            return false;
+        }
+        const RawGguf::TensorBytes& bytes = found->second;
+        const bool same_type = tensor->type == bytes.type;
+        const bool bf16_to_f32 = !same_type && tensor->type == GGML_TYPE_F32 && bytes.type == GGML_TYPE_BF16;
+        bool dims_match = tensor->ne[0] == bytes.ne[0] && tensor->ne[1] == bytes.ne[1] &&
+                          tensor->ne[2] == bytes.ne[2] && tensor->ne[3] == bytes.ne[3];
+        if (!dims_match) {
+            LOG_ERROR("tensor %s type/dims mismatch with the gguf file", name.c_str());
+            return false;
+        }
+        if (same_type) {
+            if (static_cast<size_t>(ggml_nbytes(tensor)) != bytes.bytes) {
+                LOG_ERROR("tensor %s: gguf bytes %zu != expected %zu",
+                          name.c_str(), bytes.bytes, (size_t)ggml_nbytes(tensor));
+                return false;
+            }
+            tensor->data = const_cast<uint8_t*>(bytes.data);
+        } else if (bf16_to_f32) {
+            const int64_t elements = ggml_nelements(tensor);
+            auto widened = std::make_unique<float[]>(elements);
+            for (int64_t i = 0; i < elements; ++i) {
+                uint16_t value = 0;
+                std::memcpy(&value, bytes.data + i * 2, 2);
+                uint32_t bits = static_cast<uint32_t>(value) << 16;
+                std::memcpy(&widened[i], &bits, 4);
+            }
+            tensor->data = widened.get();
+            conversions.push_back(std::move(widened));
+        } else {
+            LOG_ERROR("tensor %s: unsupported gguf type %s for param type %s",
+                      name.c_str(), ggml_type_name(bytes.type), ggml_type_name(tensor->type));
+            return false;
+        }
+    }
+    LOG_INFO("filled %zu param tensors from gguf", params.size());
+    return true;
+}
+
+HarnessOptions parse_options(int argc, char** argv) {
+    HarnessOptions options;
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg = argv[i];
+        auto value = [&](const char* error) -> std::string {
+            if (i + 1 >= argc) {
+                LOG_ERROR("%s", error);
+                exit(2);
+            }
+            return argv[++i];
+        };
+        if (arg == "--diffusion-model") {
+            options.diffusion_model = value("--diffusion-model requires a path");
+        } else if (arg == "--threads") {
+            options.threads = std::atoi(value("--threads requires a number").c_str());
+        } else if (arg == "--latent-w") {
+            options.latent_w = std::atoll(value("--latent-w requires a number").c_str());
+        } else if (arg == "--latent-h") {
+            options.latent_h = std::atoll(value("--latent-h requires a number").c_str());
+        } else if (arg == "--context-len") {
+            options.context_len = std::atoll(value("--context-len requires a number").c_str());
+        } else if (arg == "--timestep") {
+            options.timestep = std::atof(value("--timestep requires a number").c_str());
+        } else if (arg == "--seed") {
+            options.seed = static_cast<uint32_t>(std::strtoul(value("--seed requires a number").c_str(), nullptr, 10));
+        } else {
+            LOG_ERROR("unknown argument %s", arg.c_str());
+            exit(2);
+        }
+    }
+    if (options.diffusion_model.empty()) {
+        LOG_ERROR("--diffusion-model is required");
+        exit(2);
+    }
+    return options;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    sd_set_log_callback(harness_log, nullptr);
+    const HarnessOptions options = parse_options(argc, argv);
+
+    ModelLoader loader;
+    if (!loader.init_from_file(options.diffusion_model, "")) {
+        LOG_ERROR("failed to load %s", options.diffusion_model.c_str());
+        return 1;
+    }
+
+    ggml_backend_t backend = ggml_backend_cpu_init();
+    if (backend == nullptr) {
+        LOG_ERROR("failed to initialize CPU backend");
+        return 1;
+    }
+
+    Qwen::QwenImage21Runner runner(backend, loader.get_tensor_storage_map(), "model.diffusion_model", nullptr, nullptr);
+    LOG_INFO("qwen_image_2_1 config: layers=%d hidden=%" PRId64 " context=%" PRId64,
+             runner.config.num_layers, runner.config.hidden_size, runner.config.context_dim);
+
+    RawGguf raw_gguf;
+    if (!load_raw_gguf(options.diffusion_model, raw_gguf)) {
+        LOG_ERROR("failed to parse gguf file %s", options.diffusion_model.c_str());
+        return 1;
+    }
+    if (!fill_params_from_gguf(runner, raw_gguf)) {
+        return 1;
+    }
+
+    // Latent layout matches the oracle: ggml ne = [W, H, C, 1].
+    sd::Tensor<float> x({options.latent_w, options.latent_h, runner.config.in_channels, 1});
+    uint32_t state = options.seed;
+    for (auto& value : x.values()) {
+        value = next_value(state);
+    }
+    sd::Tensor<float> context({runner.config.context_dim, options.context_len});
+    for (auto& value : context.values()) {
+        value = next_value(state);
+    }
+    sd::Tensor<float> timesteps({1}, {options.timestep});
+
+    DiffusionParams params;
+    params.x         = &x;
+    params.context   = &context;
+    params.timesteps = &timesteps;
+    params.extra     = QwenImage21DiffusionExtra{};
+
+    sd::Tensor<float> result = runner.compute(options.threads, params);
+    if (result.empty()) {
+        LOG_ERROR("oracle compute failed");
+        return 1;
+    }
+    qwen_image_2_1_trace_f32("qwen.output", result.values(), result.shape());
+
+    // The velocity contract: one value per latent element.
+    if (result.numel() != x.numel()) {
+        LOG_ERROR("unexpected output size %zu vs %zu", (size_t)result.numel(), (size_t)x.numel());
+        return 1;
+    }
+    LOG_INFO("oracle compute ok: %zu outputs", (size_t)result.numel());
+    ggml_backend_free(backend);
+    return 0;
+}
