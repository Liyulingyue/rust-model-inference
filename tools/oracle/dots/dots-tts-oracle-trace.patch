diff --git a/src/dots_tts/oracle_trace.py b/src/dots_tts/oracle_trace.py
new file mode 100644
index 0000000..a2bb11e
--- /dev/null
+++ b/src/dots_tts/oracle_trace.py
@@ -0,0 +1,77 @@
+from __future__ import annotations
+
+import json
+import os
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+import torch
+
+_COUNTS: dict[str, int] = defaultdict(int)
+_NOISE: dict[str, tuple[np.ndarray, int]] = {}
+
+
+def _trace_path() -> Path | None:
+    value = os.environ.get("DOTS_TTS_ORACLE_TRACE")
+    return None if value is None else Path(value)
+
+
+def tensor(name: str, value: torch.Tensor, *, step: int | None = None) -> None:
+    trace_path = _trace_path()
+    if trace_path is None:
+        return
+    directory = trace_path.parent
+    occurrence = _COUNTS[name]
+    _COUNTS[name] += 1
+    array = value.detach().to(device="cpu", dtype=torch.float32).contiguous().numpy()
+    array = np.asarray(array, dtype="<f4")
+    path = directory / f"{trace_path.name}.{name}.{occurrence}.f32"
+    array.tofile(path)
+    with trace_path.open("a", encoding="utf-8") as stream:
+        stream.write(json.dumps({
+            "name": name,
+            "occurrence": occurrence,
+            "step": step,
+            "shape": list(array.shape),
+            "path": str(path),
+        }, separators=(",", ":")) + "\n")
+
+
+def token_ids(name: str, value: torch.Tensor) -> None:
+    trace_path = _trace_path()
+    if trace_path is None:
+        return
+    values = [int(item) for item in value.detach().cpu().reshape(-1).tolist()]
+    with trace_path.open("a", encoding="utf-8") as stream:
+        stream.write(json.dumps({
+            "name": name,
+            "shape": [len(values)],
+            "len": len(values),
+            "token_ids": values,
+        }, separators=(",", ":")) + "\n")
+
+
+def fixed_noise(kind: str, like: torch.Tensor) -> torch.Tensor:
+    if kind not in _NOISE:
+        env_name = f"DOTS_TTS_ORACLE_{kind.upper()}_NOISE"
+        path = os.environ.get(env_name)
+        if path is None:
+            return torch.randn_like(like)
+        _NOISE[kind] = (np.fromfile(path, dtype="<f4"), 0)
+    values, offset = _NOISE[kind]
+    end = offset + like.numel()
+    if end > values.size:
+        raise RuntimeError(f"{kind} noise is short: need {end}, have {values.size}")
+    _NOISE[kind] = (values, end)
+    return torch.from_numpy(values[offset:end].copy()).reshape(like.shape).to(
+        device=like.device, dtype=like.dtype
+    )
+
+
+def assert_noise_consumed() -> None:
+    for kind, (values, offset) in _NOISE.items():
+        if offset != values.size:
+            raise RuntimeError(
+                f"{kind} noise has trailing values: consumed {offset}, have {values.size}"
+            )
