diff --git a/common/debug.cpp b/common/debug.cpp
index 102c6924d..870eef487 100644
--- a/common/debug.cpp
+++ b/common/debug.cpp
@@ -4,6 +4,8 @@
 #include "log.h"
 
 #include <cmath>
+#include <cstdio>
+#include <cstdlib>
 #include <regex>
 #include <string>
 #include <vector>
@@ -181,6 +183,32 @@ bool common_debug_cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
         ggml_backend_tensor_get(t, pimpl->data.data(), 0, n_bytes);
     }
 
+    if (const char * dir = std::getenv("RMI_ORACLE_DUMP")) {
+        static unsigned sequence = 0;
+        const char * filter = std::getenv("RMI_ORACLE_FILTER");
+        if (!ggml_is_quantized(t->type) && (!filter || std::regex_search(t->name, std::regex(filter)))) {
+            char path[4096];
+            std::snprintf(path, sizeof(path), "%s/%04u.f32", dir, sequence++);
+            FILE * f = std::fopen(path, "wb");
+            GGML_ASSERT(f);
+            const uint8_t * data = is_host ? (uint8_t *) t->data : pimpl->data.data();
+            for (int64_t i3 = 0; i3 < t->ne[3]; ++i3)
+            for (int64_t i2 = 0; i2 < t->ne[2]; ++i2)
+            for (int64_t i1 = 0; i1 < t->ne[1]; ++i1)
+            for (int64_t i0 = 0; i0 < t->ne[0]; ++i0) {
+                float v = common_ggml_get_float_value(data, t->type, t->nb, i0, i1, i2, i3);
+                GGML_ASSERT(std::fwrite(&v, sizeof(v), 1, f) == 1);
+            }
+            std::fclose(f);
+            std::snprintf(path, sizeof(path), "%s/index.tsv", dir);
+            f = std::fopen(path, "a");
+            GGML_ASSERT(f);
+            std::fprintf(f, "%04u\t%s\t%s\n", sequence - 1, t->name, common_ggml_ne_string(t).c_str());
+            std::fclose(f);
+        }
+        return true;
+    }
+
     if (!ggml_is_quantized(t->type) && matches_filter) {
         uint8_t * data = is_host ? (uint8_t *) t->data : pimpl->data.data();
         common_debug_print_tensor(data, t->type, t->ne, t->nb, 3, pimpl->abort_on_nan);
