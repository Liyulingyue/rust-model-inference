+    void write_moe(const std::vector<llama_token> & tokens, int n_layer, int step) {
+        write_tokens("qwen35moe.prompt_ids", tokens);
+        for (int layer = 0; layer < n_layer; ++layer) {
+            const std::string suffix = "-" + std::to_string(layer);
+            // Boundary nodes for every layer: this is the per-layer profile.
+            for (const char * name : {"attn_post_norm", "l_out"}) {
+                const std::string full = std::string(name) + suffix;
+                if (!tensors_.count(full)) continue;
+                write_moe_tensor(full, name, layer, step);
+            }
+        }
+        for (int layer : {0, 3, last_layer}) {
+            const std::string suffix = "-" + std::to_string(layer);
+            for (const char * name : {
+                    "ffn_moe_logits", "ffn_moe_probs", "ffn_moe_topk",
+                    "ffn_moe_weights", "ffn_moe_weights_sum",
+                    "ffn_moe_weights_sum_clamped", "ffn_moe_weights_norm",
+                    "ffn_moe_weights_scaled", "ffn_moe_out", "ffn_out",
+                    "ffn_shexp", "ffn_shexp_gated",
+                    "shared_expert_gate", "shared_expert_gate_sigmoid"}) {
+                const std::string full = std::string(name) + suffix;
+                if (!tensors_.count(full)) continue;
+                write_moe_tensor(full, name, layer, step);
+            }
+        }
+    // SSM internals, layer 1 only.
+    //
+    // The per-layer profile says layer 0 is fine (its output differs by 1.9e-9,
+    // the MoE's own accumulation) and layer 1 turns that into 1.3e-5 -- an
+    // amplification of roughly 7000x, which no well-conditioned layer does to
+    // its input. So the difference is inside layer 1's recurrence, and these are
+    // the nodes that place it: the short convolution on the way in, the two
+    // pre-delta convolutions, the state update, and the attention output the
+    // state is read into. Layer 0 is not dumped for these because it is already
+    // known good, and every one of these is large enough that dumping all
+    // forty layers would be wasteful.
+    // `q_conv` and `k_conv` are the linear's output, before the L2 norm that
+    // produces `q_conv_predelta`. Having both says whether a difference came
+    // out of the projection or out of the normalisation.
+    for (const char * name : {"conv_output_raw", "q_conv", "k_conv",
+                              "q_conv_predelta", "k_conv_predelta",
+                              "state_predelta", "final_output"}) {
+        const std::string full = std::string(name) + "-1";
+        if (!tensors_.count(full)) continue;
+        write_moe_tensor(full, name, 1, step);
+    }
+
+    // Attention chain at layer 3, the first dense layer, in graph order.
+    for (const char * name : {"attn_norm", "Qcur", "Kcur", "Vcur", "z",
+                              "Qcur_normed", "Kcur_normed",
+                              "attn_gated", "attn_output", "attn_residual",
+                              "attn_post_norm"}) {
+        const std::string full = std::string(name) + "-3";
+        if (!tensors_.count(full)) continue;
+        write_moe_tensor(full, name, 3, step);
+    }
+
+        // The final logits.
+        //
+        // Every per-layer checkpoint answers "do the experts compute the same
+        // thing", which is not the question a user has. The question is whether
+        // the model emits the same token. Two layers out of forty carrying a
+        // 3.6e-4 relative difference say nothing about whether that survives to
+        // the argmax, so the comparison has to end here.
+        for (const char * name : {"result_norm", "result_output"}) {
+            if (!tensors_.count(name)) continue;
+            write_moe_tensor(name, name, -1, step);
+        }
+        (void) n_layer;
+    }
