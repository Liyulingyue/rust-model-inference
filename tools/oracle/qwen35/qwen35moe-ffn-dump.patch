 static int last_layer = 63;
 
+// qwen35moe routed + shared expert nodes. These are the names build_moe_ffn
+// (llama-graph.cpp) and llama_model_qwen35moe::build_layer_ffn actually emit;
+// nothing here is invented. The per-layer suffix is added by cb(), hence
+// selected_layer. ffn_moe_input is deliberately absent: no oracle node carries
+// it, so comparing it would be comparing two different things.
+static bool selected_moe(const std::string & name) {
+    for (int layer : {0, 3, last_layer}) {
+        for (const char * prefix : {
+                "ffn_moe_logits", "ffn_moe_probs", "ffn_moe_topk", "ffn_moe_argsort",
+                "ffn_moe_weights", "ffn_moe_weights_sum",
+                "ffn_moe_weights_sum_clamped", "ffn_moe_weights_norm",
+                "ffn_moe_weights_scaled", "ffn_moe_out", "ffn_out",
+                "ffn_shexp", "ffn_shexp_gated",
+                "shared_expert_gate", "shared_expert_gate_sigmoid"}) {
+            if (selected_layer(name, prefix, layer)) return true;
+        }
+    }
+    // Per-layer boundary, every layer. Three spot checks located the difference
+    // ("layer 0 exact, layer 3 differs") but not where it starts, and this is
+    // the node that says: `attn_post_norm` is the FFN's input, so the first
+    // layer where it disagrees names the first layer that computed something
+    // differently. Without it every hypothesis about the attention or SSM half
+    // is a guess. Cost is 40 x 2048 floats per side, which is nothing.
+    for (const char * prefix : {"attn_post_norm", "l_out"}) {
+        const char * digits = prefix + strlen(prefix);
+        (void) digits;
+        if (starts_with(name, prefix) && name.find('-') != std::string::npos) {
+            const size_t dash = name.rfind('-');
+            const std::string tail = name.substr(dash + 1);
+            if (!tail.empty() && tail.find_first_not_of("0123456789") == std::string::npos) {
+                return true;
+            }
+        }
+    }
+    // SSM internals at layer 1; see the comment where they are written.
+    for (const char * prefix : {"conv_output_raw", "q_conv", "k_conv",
+                                "q_conv_predelta", "k_conv_predelta",
+                                "state_predelta", "final_output"}) {
+        if (selected_layer(name, prefix, 1)) return true;
+    }
+    // Attention internals at layer 3, the first dense layer. Once the L2 norm
+    // matched, layers 0-2 (SSM) came back to ~1e-9 and the first remaining
+    // difference is at layer 3's FFN input -- so the split moved into the
+    // attention path. These are the nodes along it.
+    for (const char * prefix : {"attn_norm", "Qcur_normed", "Kcur_normed",
+                                "Qcur", "Kcur", "Vcur", "attn_gated",
+                                "attn_output", "attn_residual", "attn_post_norm"}) {
+        if (selected_layer(name, prefix, 3)) return true;
+    }
+    return false;
+}
