+private:
+    // Writes one MoE checkpoint keyed on (name, layer, step).
+    //
+    // I32 is widened to f32 on write. ffn_moe_topk is the oracle's I32 node and
+    // the Rust side emits the same ids as f32, so one binary format on both
+    // sides is what lets them join; expert ids are small and survive the
+    // widening exactly. The alternative -- keeping I32 here -- means the compare
+    // script has to know which names are integer-typed, which is exactly the
+    // kind of assumption that turns into a silent mismatch later.
+    void write_moe_tensor(const std::string & source_name, const std::string & output_name,
+            int layer, int step) {
+        const auto & snapshot = get(source_name);
+        std::vector<float> values;
+        if (snapshot.type == GGML_TYPE_F32) {
+            values = snapshot.f32;
+        } else if (snapshot.type == GGML_TYPE_I32) {
+            values.reserve(snapshot.i32.size());
+            for (int32_t value : snapshot.i32) values.push_back(float(value));
+        } else {
+            throw std::runtime_error("moe checkpoint is neither F32 nor I32: " + source_name);
+        }
+        std::vector<int64_t> shape;
+        for (int64_t i = 0; i < GGML_MAX_DIMS; ++i) {
+            if (snapshot.ne[i] > 1) shape.push_back(snapshot.ne[i]);
+        }
+        // A one-token run makes every scalar checkpoint a 1-element tensor whose
+        // ne is all ones -- ffn_moe_weights_sum, ffn_moe_weights_sum_clamped,
+        // shared_expert_gate, shared_expert_gate_sigmoid. Dropping every
+        // dimension of extent 1 leaves nothing, so fall back to the element
+        // count. Without this the run aborts on the first scalar, after the
+        // vector checkpoints have already been written, which looks like a
+        // silent truncation rather than a failure.
+        if (shape.empty()) shape.push_back(int64_t(values.size()));
+        size_t expected = 1;
+        for (int64_t dimension : shape) expected *= size_t(dimension);
+        if (expected != values.size()) {
+            throw std::runtime_error("moe shape mismatch for " + source_name);
+        }
+        const size_t occurrence = occurrences_[output_name]++;
+        std::string binary_path = path_ + "." + output_name;
+        if (occurrence) binary_path += "." + std::to_string(occurrence);
+        binary_path += ".f32";
+        std::ofstream binary(binary_path, std::ios::binary | std::ios::trunc);
+        for (float value : values) {
+            uint32_t bits;
+            std::memcpy(&bits, &value, sizeof(bits));
+            const char bytes[] = {char(bits), char(bits >> 8), char(bits >> 16), char(bits >> 24)};
+            binary.write(bytes, sizeof(bytes));
+        }
+        if (!binary) throw std::runtime_error("failed to write " + binary_path);
+
+        manifest_ << "{\"name\":\"" << output_name << "\",\"layer\":" << layer
+                  << ",\"step\":" << step << ",\"shape\":[";
+        write_shape(shape);
+        manifest_ << "],\"len\":" << values.size() << ",\"occurrence\":" << occurrence
+                  << ",\"binary_path\":\"" << json_escape(binary_path) << "\"}\n";
+        manifest_.flush();
+    }
