+// qwen35moe: one token in, one token out.
+//
+// The refusal on tokens.size() != 1 is the whole point. llama.cpp pads a
+// multi-token prefill ubatch with three rows at each end, so a 3-token prompt
+// reaches the graph as [pad,pad,pad,t1,t2,t3,pad,pad,pad]. Comparing "our token
+// i" against "oracle row i" is then a misalignment, and this branch has already
+// published and retracted a ~14% discrepancy that came from exactly that. With
+// one token there is no padding row and step 0 is the same real token on both
+// sides.
+static bool run_moe(llama_context * ctx, const common_params & params, parity_trace & trace) {
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const bool add_bos = llama_vocab_get_add_bos(vocab);
+    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, add_bos, true);
+    if (tokens.size() != 1) {
+        throw std::runtime_error(
+                "qwen35moe oracle needs exactly one token so no ubatch padding can be "
+                "confused with a real token; got " + std::to_string(tokens.size()));
+    }
+    const int n_layer = llama_model_n_layer(model);
+    if (llama_decode(ctx, llama_batch_get_one(tokens.data(), 1))) return false;
+    trace.write_moe(tokens, n_layer, 0);
+    return true;
+}
