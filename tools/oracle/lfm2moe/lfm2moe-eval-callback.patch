+    void write_sidecar(
+            const char * name, int layer, int step, const std::vector<int64_t> & shape,
+            const std::vector<float> & values, const std::vector<int32_t> & int_values) {
+        const size_t occurrence = occurrences_[name]++;
+        std::string binary_path = path_ + "." + name;
+        if (occurrence) {
+            binary_path += "." + std::to_string(occurrence);
+        }
+        binary_path += ".f32";
+
+        {
+            std::ofstream binary(binary_path, std::ios::binary | std::ios::trunc);
+            const size_t count = int_values.empty() ? values.size() : int_values.size();
+            for (size_t i = 0; i < count; ++i) {
+                uint32_t bits;
+                if (!int_values.empty()) {
+                    const int32_t raw = int_values[i];
+                    std::memcpy(&bits, &raw, sizeof(bits));
+                } else {
+                    const float raw = values[i];
+                    std::memcpy(&bits, &raw, sizeof(bits));
+                }
+                const char bytes[] = {char(bits), char(bits >> 8), char(bits >> 16), char(bits >> 24)};
+                binary.write(bytes, sizeof(bytes));
+            }
+            if (!binary) {
+                throw std::runtime_error("failed to write " + binary_path);
+            }
+        }
