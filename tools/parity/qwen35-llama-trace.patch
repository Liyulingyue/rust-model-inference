+static llama_token greedy_token(llama_context * ctx, int n_vocab) {
+    const float * logits = llama_get_logits_ith(ctx, -1);
+    int best = 0;
+    for (int token = 1; token < n_vocab; ++token) {
+        if (logits[token] > logits[best]) best = token;
+    }
+    return best;
+}
+
+static bool run(llama_context * ctx, const common_params & params, parity_trace & trace) {
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    char architecture[32];
+    if (llama_model_meta_val_str(model, "general.architecture", architecture, sizeof(architecture)) < 0 ||
+            std::string(architecture) != "qwen35") {
+        throw std::runtime_error("Oracle requires general.architecture=qwen35");
+    }
+    const int n_layer = llama_model_n_layer(model);
+    const int n_nextn = llama_model_n_layer_nextn(model);
+    if (n_layer != 64 || n_nextn != 1) {
+        throw std::runtime_error("Oracle requires 64 trunk layers and one NextN layer");
+    }
+    if (params.n_predict != 1) throw std::runtime_error("Oracle requires -n 1");
+
+    const bool add_bos = llama_vocab_get_add_bos(vocab);
+    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, add_bos, true);
+    if (tokens.empty()) {
+        LOG_ERR("there are no input tokens\n");
+        return false;
+    }
+    if (llama_decode(ctx, llama_batch_get_one(tokens.data(), tokens.size()))) {
+        LOG_ERR("failed to evaluate prompt\n");
+        return false;
+    }
+
+    const int n_embd = llama_model_n_embd(model);
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+    trace.write(tokens, n_layer, n_embd, n_vocab);
+    trace.write_greedy(greedy_token(ctx, n_vocab));
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) return 1;
+
+    parity_trace trace(std::getenv("RMI_PARITY_TRACE"));
+    params.cb_eval = parity_eval_callback;
+    params.cb_eval_user_data = &trace;
+    params.warmup = false;
+    llama_backend_init();
+    llama_numa_init(params.numa);
+    auto llama_init = common_init_from_params(params);
+    auto * model = llama_init->model();
+    auto * ctx = llama_init->context();
+    if (model == nullptr || ctx == nullptr) return 1;
+
+    const bool ok = run(ctx, params, trace);
+    if (ok) llama_perf_context_print(ctx);
+    llama_backend_free();
+    return ok ? 0 : 1;
 }
