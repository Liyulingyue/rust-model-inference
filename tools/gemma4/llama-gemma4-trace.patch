+#ifdef LLAMA_GEMMA4_TRACE
+class gemma4_trace {
+public:
+    explicit gemma4_trace(const char * path) : path_(path ? path : "") {
+        if (!path_.empty()) manifest_.open(path_, std::ios::trunc);
+    }
+
+    ~gemma4_trace() { flush(); }
+
+    bool enabled() const { return manifest_.is_open() && !failed_; }
+
+    static bool callback(ggml_tensor * tensor, bool ask, void * user_data) {
+        return static_cast<gemma4_trace *>(user_data)->capture(tensor, ask);
+    }
+
+    void write_tokens(const char * name, const llama_tokens & values, bool generated = false) {
+        if (!enabled()) return;
+        std::lock_guard<std::mutex> lock(mutex_);
+        const size_t occurrence = occurrences_[name]++;
+        std::ostringstream line;
+        line << "{\"name\":\"" << json_escape(name) << "\",\"shape\":[" << values.size()
+             << "],\"len\":" << values.size() << ",\"occurrence\":" << occurrence << ",\"token_ids\":[";
+        for (size_t i = 0; i < values.size(); ++i) {
+            if (i) line << ',';
+            line << values[i];
+        }
+        line << "]}\n";
+        (generated ? generated_ : tokens_) = line.str();
+    }
+
+private:
+    enum class shape_kind { native, audio_mel, text };
+    enum class section { frontend, text };
+
+    struct checkpoint {
+        std::string name;
+        int layer = -1;
+        shape_kind shape = shape_kind::native;
+        section output = section::frontend;
+    };
+
+    static std::string json_escape(const std::string & value) {
+        std::string escaped;
+        for (char ch : value) {
+            if (ch == '\\' || ch == '"') escaped.push_back('\\');
+            escaped.push_back(ch);
+        }
+        return escaped;
+    }
+
+    static bool layer_checkpoint(
+            const std::string & tensor_name,
+            const char * prefix,
+            const char * suffix,
+            checkpoint & output) {
+        const size_t prefix_len = std::strlen(prefix);
+        if (tensor_name.compare(0, prefix_len, prefix) != 0) return false;
+        char * end = nullptr;
+        const long layer = std::strtol(tensor_name.c_str() + prefix_len, &end, 10);
+        if (layer < 0 || end == tensor_name.c_str() + prefix_len || *end != '\0') return false;
+        output.name = "gemma4.layer." + std::to_string(layer) + "." + suffix;
+        output.layer = static_cast<int>(layer);
+        output.shape = shape_kind::text;
+        output.output = section::text;
+        return true;
+    }
+
+    static bool map_tensor(const ggml_tensor * tensor, checkpoint & output) {
+        const std::string name = tensor->name;
+        if (name == "vision_preprocessed") {
+            output.name = "gemma4.vision.preprocessed";
+            return true;
+        }
+        if (name == "projected") {
+            output.name = "gemma4.vision.projected";
+            return true;
+        }
+        if (name == "audio_mel") {
+            output.name = "gemma4.audio.mel";
+            output.shape = shape_kind::audio_mel;
+            return true;
+        }
+        if (name == "audio_projected") {
+            output.name = "gemma4.audio.projected";
+            return true;
+        }
+        if (name == "result_norm") {
+            output.name = "gemma4.final.norm";
+            output.shape = shape_kind::text;
+            output.output = section::text;
+            return true;
+        }
+        if (name == "result_output") {
+            output.name = "gemma4.logits";
+            output.shape = shape_kind::text;
+            output.output = section::text;
+            return true;
+        }
+        if (tensor->ne[0] != 1536 || tensor->ne[1] != 1 || tensor->ne[2] != 1 || tensor->ne[3] != 1) return false;
+        return layer_checkpoint(name, "attn_out-", "attn_out", output)
+            || layer_checkpoint(name, "pe_in-", "ffn_out", output)
+            || layer_checkpoint(name, "l_out-", "per_layer_out", output);
+    }
+
+    bool capture(ggml_tensor * tensor, bool ask) {
+        checkpoint mapped;
+        const bool selected = map_tensor(tensor, mapped);
+        if (ask) return enabled() && selected && tensor->type == GGML_TYPE_F32;
+        if (!enabled()) return true;
+        if (!selected || tensor->type != GGML_TYPE_F32) return true;
+
+        std::lock_guard<std::mutex> lock(mutex_);
+        std::vector<uint8_t> bytes(ggml_nbytes(tensor));
+        ggml_backend_tensor_get(tensor, bytes.data(), 0, bytes.size());
+        std::vector<float> values;
+        values.reserve(ggml_nelements(tensor));
+        for (int64_t i3 = 0; i3 < tensor->ne[3]; ++i3) {
+            for (int64_t i2 = 0; i2 < tensor->ne[2]; ++i2) {
+                for (int64_t i1 = 0; i1 < tensor->ne[1]; ++i1) {
+                    for (int64_t i0 = 0; i0 < tensor->ne[0]; ++i0) {
+                        const size_t offset = i3 * tensor->nb[3] + i2 * tensor->nb[2]
+                            + i1 * tensor->nb[1] + i0 * tensor->nb[0];
+                        float value;
+                        std::memcpy(&value, bytes.data() + offset, sizeof(value));
+                        values.push_back(value);
+                    }
+                }
+            }
+        }

+        const size_t occurrence = occurrences_[mapped.name]++;
+        const std::string binary_path = path_ + "." + mapped.name + "." + std::to_string(occurrence) + ".f32";
+        std::ofstream binary(binary_path, std::ios::binary | std::ios::trunc);
+        binary.write(reinterpret_cast<const char *>(values.data()),
+            static_cast<std::streamsize>(values.size() * sizeof(float)));
+        if (!binary) return failed_ = true, false;
+
+        std::ostringstream line;
+        line << "{\"name\":\"" << json_escape(mapped.name) << "\",\"layer\":";
+        if (mapped.layer >= 0) line << mapped.layer;
+        else line << "null";
+        line << ",\"step\":null,\"shape\":[";
+        if (mapped.shape == shape_kind::text) {
+            line << "1," << values.size();
+        } else if (mapped.shape == shape_kind::audio_mel) {
+            line << tensor->ne[1] << ',' << tensor->ne[0];
+        } else {
+            for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+                if (i) line << ',';
+                line << tensor->ne[i];
+            }
+        }
+        line << "],\"len\":" << values.size() << ",\"occurrence\":" << occurrence
+             << ",\"binary_path\":\"" << json_escape(binary_path) << "\"}\n";
+        (mapped.output == section::frontend ? frontend_ : text_).push_back(line.str());
+        return true;
+    }
+
+    void flush() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!manifest_.is_open()) return;
+        for (const std::string & line : frontend_) manifest_ << line;
+        manifest_ << tokens_;
+        for (const std::string & line : text_) manifest_ << line;
+        manifest_ << generated_;
+        manifest_.flush();
+        failed_ = !manifest_;
+    }
+
+    std::string path_;
+    std::ofstream manifest_;
+    std::map<std::string, size_t> occurrences_;
+    std::vector<std::string> frontend_;
+    std::string tokens_;
+    std::vector<std::string> text_;
+    std::string generated_;
+    std::mutex mutex_;
+    bool failed_ = false;
+};
+#endif
