diff --git a/src/z_image_trace.hpp b/src/z_image_trace.hpp
new file mode 100644
index 0000000..d0e68be
--- /dev/null
+++ b/src/z_image_trace.hpp
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+inline const char* z_image_trace_path() {
+    return std::getenv("Z_IMAGE_ORACLE_TRACE");
+}
+
+inline std::string z_image_trace_json_string(const std::string& value) {
+    std::string out = "\"";
+    for (char ch : value) {
+        if (ch == '\\' || ch == '\"') out += '\\';
+        out += ch;
+    }
+    return out + "\"";
+}
+
+inline bool z_image_trace_raw(const std::string& name,
+                              const void* data,
+                              size_t element_size,
+                              size_t count,
+                              std::vector<int64_t> shape,
+                              const char* type) {
+    const char* trace = z_image_trace_path();
+    if (trace == nullptr) return true;
+    while (shape.size() > 1 && shape.back() == 1) shape.pop_back();
+    size_t expected = 1;
+    for (int64_t dimension : shape) {
+        if (dimension < 0) return false;
+        expected *= static_cast<size_t>(dimension);
+    }
+    if (expected != count) return false;
+
+    static std::mutex mutex;
+    static std::map<std::string, size_t> occurrences;
+    std::lock_guard<std::mutex> lock(mutex);
+    size_t occurrence = occurrences[name]++;
+    std::string sidecar = std::string(trace) + "." + name;
+    if (occurrence != 0) sidecar += "." + std::to_string(occurrence);
+    sidecar += "." + std::string(type);
+
+    std::ofstream binary(sidecar, std::ios::binary | std::ios::trunc);
+    binary.write(static_cast<const char*>(data), static_cast<std::streamsize>(count * element_size));
+    if (!binary) return false;
+
+    std::ofstream json(trace, std::ios::app);
+    json << "{\"name\":" << z_image_trace_json_string(name) << ",\"shape\":[";
+    for (size_t i = 0; i < shape.size(); ++i) {
+        if (i != 0) json << ',';
+        json << shape[i];
+    }
+    json << "],\"len\":" << count << ",\"occurrence\":" << occurrence
+         << ",\"binary_path\":" << z_image_trace_json_string(sidecar) << "}\n";
+    return static_cast<bool>(json);
+}
+
+inline bool z_image_trace_f32(const std::string& name,
+                              const std::vector<float>& values,
+                              std::vector<int64_t> shape) {
+    return z_image_trace_raw(name, values.data(), sizeof(float), values.size(), std::move(shape), "f32");
+}
+
+inline bool z_image_trace_i32(const std::string& name,
+                              const std::vector<int32_t>& values,
+                              std::vector<int64_t> shape) {
+    return z_image_trace_raw(name, values.data(), sizeof(int32_t), values.size(), std::move(shape), "i32");
+}
