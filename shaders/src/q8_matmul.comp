#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 1) in;

layout(binding = 0) readonly buffer WeightBuffer {
    uint8_t weight[];
};

layout(binding = 1) readonly buffer InputBuffer {
    uint8_t input_q8[];
};

layout(binding = 2) readonly buffer ScaleBuffer {
    float input_scales[];
};

layout(binding = 3) writeonly buffer OutputBuffer {
    float out_data[];
};

layout(push_constant) uniform PushConstants {
    uint n_in;
    uint n_out;
    uint blocks_per_row;
    uint row_stride;
} pc;

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= pc.n_out) {
        return;
    }

    float sum = 0.0;

    for (uint block = 0; block < pc.blocks_per_row; block++) {
        uint weight_off = out_idx * pc.row_stride + block * 34;
        uint input_off = block * 32;

        uint scale_bits = uint(weight[weight_off]) | (uint(weight[weight_off + 1]) << 8);
        float weight_scale = unpackFloat2x16(scale_bits).x;

        float in_scale = input_scales[block];

        int dot = 0;
        for (uint i = 0; i < 32; i++) {
            int w_val = int(int8_t(weight[weight_off + 2 + i]));
            int in_val = int(int8_t(input_q8[input_off + i]));
            dot += w_val * in_val;
        }

        sum += weight_scale * in_scale * float(dot);
    }

    out_data[out_idx] = sum;
}
