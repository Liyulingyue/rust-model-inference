#version 450
#extension GL_GOOGLE_include_directive : require
#include "f16_rounding.glsl"

layout(local_size_x = 32) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint input_word;
    uint q8_word;
    uint scales_word;
    uint input_sums_word;
    uint count;
    uint input_stride;
    uint q8_stride;
    uint scales_stride;
    uint input_sums_stride;
    uint token_rows;
} pc;

shared float values[32];
shared float partial[32];
shared int quantized_values[32];
shared int partial_sum[32];
shared float inverse_scale;
shared float raw_scale;

#include "f32_divide.glsl"

void main() {
    uint row = gl_WorkGroupID.z;
    uint block = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint blocks = pc.count / 32u;
    if (block >= blocks) return;
    uint input_base = row * pc.input_stride;
    uint q8_base = row * pc.q8_stride;
    uint scales_base = row * pc.scales_stride;
    uint sums_base = row * pc.input_sums_stride;

    uint lane = gl_LocalInvocationID.x;
    float value = uintBitsToFloat(arena.data[pc.input_word + input_base + block * 32u + lane]);
    values[lane] = value;
    partial[lane] = abs(value);
    barrier();

    for (uint step = 16u; step > 0u; step >>= 1u) {
        if (lane < step) partial[lane] = max(partial[lane], partial[lane + step]);
        barrier();
    }

    if (lane == 0u) {
        precise float scale = partial[0] == 0.0
            ? 0.0
            : divide_finite_normal(partial[0], 127.0);
        raw_scale = scale;
        inverse_scale = partial[0] == 0.0
            ? 0.0
            // Match CPU's rounded scale before taking its reciprocal.
            : divide_finite_normal(1.0, scale);
        float stored_scale = round_f16_rte(scale);
        arena.data[pc.scales_word + scales_base + block] = floatBitsToUint(stored_scale);
    }
    barrier();

    if (lane < 8u) {
        uint packed = 0u;
        for (uint byte_index = 0u; byte_index < 4u; byte_index++) {
            uint value_index = lane * 4u + byte_index;
            precise float scaled = values[value_index] * inverse_scale;
            int quantized = int(roundEven(scaled));
            quantized = clamp(quantized, -128, 127);
            quantized_values[value_index] = quantized;
            packed |= (uint(quantized) & 0xffu) << (byte_index * 8u);
        }
        arena.data[pc.q8_word + q8_base + block * 8u + lane] = packed;
    }
    barrier();

    partial_sum[lane] = quantized_values[lane];
    barrier();
    for (uint step = 16u; step > 0u; step >>= 1u) {
        if (lane < step) partial_sum[lane] += partial_sum[lane + step];
        barrier();
    }
    if (lane == 0u) {
        float input_sum = round_f16_rte(float(partial_sum[0]) * raw_scale);
        arena.data[pc.input_sums_word + sums_base + block] = floatBitsToUint(input_sum);
    }
}
