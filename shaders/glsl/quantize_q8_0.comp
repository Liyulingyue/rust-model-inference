#version 450
#extension GL_GOOGLE_include_directive : require
#include "f16_rounding.glsl"

layout(local_size_x = 32) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint input_word;
    uint q8_word;
    uint scales_word;
    uint input_sums_word;
    uint count;
    uint input_stride;
    uint q8_stride;
    uint scales_stride;
    uint input_sums_stride;
    uint token_rows;
    uint cpu_mode;
} pc;

shared float values[32];
shared float partial[32];
shared int quantized_values[32];
shared int partial_sum[32];
shared float inverse_scale;
shared float raw_scale;

#include "f32_divide.glsl"

int round_away(float value) {
    float magnitude = abs(value);
    float integral = floor(magnitude);
    // Adding 0.5 first incorrectly rounds its predecessor up to 1.0.
    return int(sign(value) * (integral + (magnitude - integral >= 0.5 ? 1.0 : 0.0)));
}

float multiply_finite_normal(float left, float right) {
    uint left_bits = floatBitsToUint(left);
    uint right_bits = floatBitsToUint(right);
    uint left_exp = (left_bits >> 23u) & 0xffu;
    uint right_exp = (right_bits >> 23u) & 0xffu;
    if (left_exp == 0u || left_exp == 0xffu || right_exp == 0u || right_exp == 0xffu) {
        return left * right;
    }
    uint sign_bits = (left_bits ^ right_bits) & 0x80000000u;
    uint left_mantissa = (left_bits & 0x007fffffu) | 0x00800000u;
    uint right_mantissa = (right_bits & 0x007fffffu) | 0x00800000u;
    uint left_low = left_mantissa & 0xffffu;
    uint left_high = left_mantissa >> 16u;
    uint right_low = right_mantissa & 0xffffu;
    uint right_high = right_mantissa >> 16u;
    uint product_00 = left_low * right_low;
    uint product_01 = left_low * right_high;
    uint product_10 = left_high * right_low;
    uint product_11 = left_high * right_high;
    uint middle = (product_00 >> 16u) + (product_01 & 0xffffu) + (product_10 & 0xffffu);
    uint product_low = (product_00 & 0xffffu) | ((middle & 0xffffu) << 16u);
    uint product_high = product_11 + (product_01 >> 16u) + (product_10 >> 16u) + (middle >> 16u);
    bool top = (product_high & 0x8000u) != 0u;
    uint shift = top ? 24u : 23u;
    int exponent = int(left_exp) - 127 + int(right_exp) - 127 + (top ? 1 : 0);
    uint mantissa = (product_high << (32u - shift)) | (product_low >> shift);
    uint remainder_mask = (1u << (shift - 1u)) - 1u;
    bool guard = ((product_low >> (shift - 1u)) & 1u) != 0u;
    bool sticky = (product_low & remainder_mask) != 0u;
    if (guard && (sticky || (mantissa & 1u) != 0u)) mantissa += 1u;
    if (mantissa == 0x01000000u) {
        mantissa >>= 1u;
        exponent += 1;
    }
    int result_exp = exponent + 127;
    if (result_exp <= 0 || result_exp >= 255) return left * right;
    return uintBitsToFloat(sign_bits | (uint(result_exp) << 23u) | (mantissa & 0x007fffffu));
}

int round_even_stable(float value, float scaled, float amax, uint cpu_mode) {
    float magnitude = abs(scaled);
    float integral = floor(magnitude);
    float midpoint = integral + 0.5;
    // AMD's fast F32 multiply can land one ULP on either side of a Q8
    // half-integer. Recompute only this rare boundary with the CPU's exact
    // F32 division and multiplication order; ordinary values stay fast.
    precise float ulp = max(1.0, midpoint) * 0.0000002384185791015625;
    if (abs(magnitude - midpoint) <= ulp) {
        precise float inverse = cpu_mode == 8u
            ? divide_finite_normal(127.0, amax)
            : divide_finite_normal(1.0, amax / 127.0);
        scaled = multiply_finite_normal(value, inverse);
    }
    return int(roundEven(scaled));
}

void main() {
    uint row = gl_WorkGroupID.z;
    uint block = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint blocks = pc.count / 32u;
    if (block >= blocks) return;
    uint input_base = row * pc.input_stride;
    uint q8_base = row * pc.q8_stride;
    uint scales_base = row * pc.scales_stride;
    uint sums_base = row * pc.input_sums_stride;

    uint lane = gl_LocalInvocationID.x;
    float value = uintBitsToFloat(arena.data[pc.input_word + input_base + block * 32u + lane]);
    values[lane] = value;
    partial[lane] = abs(value);
    barrier();

    for (uint step = 16u; step > 0u; step >>= 1u) {
        if (lane < step) partial[lane] = max(partial[lane], partial[lane + step]);
        barrier();
    }

    if (lane == 0u) {
        precise float scale = partial[0] == 0.0
            ? 0.0
            : divide_finite_normal(partial[0], 127.0);
        raw_scale = scale;
        inverse_scale = partial[0] == 0.0
            ? 0.0
            // AVX2 divides directly; NEON/scalar use the rounded scale's reciprocal.
            : (pc.cpu_mode == 8u
                ? 127.0 / partial[0]
                : divide_finite_normal(1.0, scale));
        float stored_scale = round_f16_rte(scale);
        arena.data[pc.scales_word + scales_base + block] = floatBitsToUint(stored_scale);
    }
    barrier();

    if (lane < 8u) {
        uint packed = 0u;
        for (uint byte_index = 0u; byte_index < 4u; byte_index++) {
            uint value_index = lane * 4u + byte_index;
            precise float scaled = values[value_index] * inverse_scale;
            int quantized = pc.cpu_mode == 0u
                ? round_away(scaled)
                : round_even_stable(values[value_index], scaled, partial[0], pc.cpu_mode);
            quantized = clamp(quantized, -128, 127);
            quantized_values[value_index] = quantized;
            packed |= (uint(quantized) & 0xffu) << (byte_index * 8u);
        }
        arena.data[pc.q8_word + q8_base + block * 8u + lane] = packed;
    }
    barrier();

    partial_sum[lane] = quantized_values[lane];
    barrier();
    for (uint step = 16u; step > 0u; step >>= 1u) {
        if (lane < step) partial_sum[lane] += partial_sum[lane + step];
        barrier();
    }
    if (lane == 0u) {
        float input_sum = round_f16_rte(float(partial_sum[0]) * raw_scale);
        arena.data[pc.input_sums_word + sums_base + block] = floatBitsToUint(input_sum);
    }
}
