#version 450
#extension GL_GOOGLE_include_directive : require
#include "f16_rounding.glsl"

layout(local_size_x = 32) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint input_word;
    uint q8_word;
    uint scales_word;
    uint input_sums_word;
    uint count;
} pc;

shared float values[32];
shared float partial[32];
shared int quantized_values[32];
shared int partial_sum[32];
shared float inverse_scale;
shared float raw_scale;

float divide_finite_normal(float numerator, float denominator) {
    uint numerator_bits = floatBitsToUint(numerator);
    uint denominator_bits = floatBitsToUint(denominator);
    uint sign = (numerator_bits ^ denominator_bits) & 0x80000000u;
    uint numerator_exponent = (numerator_bits >> 23u) & 0xffu;
    uint denominator_exponent = (denominator_bits >> 23u) & 0xffu;
    if (numerator_exponent == 0u || numerator_exponent == 0xffu
        || denominator_exponent == 0u || denominator_exponent == 0xffu) {
        return numerator / denominator;
    }

    uint numerator_mantissa = (numerator_bits & 0x007fffffu) | 0x00800000u;
    uint denominator_mantissa = (denominator_bits & 0x007fffffu) | 0x00800000u;
    int exponent = int(numerator_exponent) - int(denominator_exponent);
    if (numerator_mantissa < denominator_mantissa) {
        numerator_mantissa <<= 1u;
        exponent -= 1;
    }

    uint quotient = 1u;
    uint remainder = numerator_mantissa - denominator_mantissa;
    for (uint bit = 0u; bit < 23u; ++bit) {
        quotient <<= 1u;
        remainder <<= 1u;
        if (remainder >= denominator_mantissa) {
            remainder -= denominator_mantissa;
            quotient |= 1u;
        }
    }

    remainder <<= 1u;
    bool guard = remainder >= denominator_mantissa;
    if (guard) remainder -= denominator_mantissa;
    bool sticky = remainder != 0u;
    if (guard && (sticky || (quotient & 1u) != 0u)) {
        quotient += 1u;
        if (quotient == 0x01000000u) {
            quotient >>= 1u;
            exponent += 1;
        }
    }

    int result_exponent = exponent + 127;
    if (result_exponent <= 0 || result_exponent >= 255) {
        return numerator / denominator;
    }
    return uintBitsToFloat(
        sign | (uint(result_exponent) << 23u) | (quotient & 0x007fffffu)
    );
}

void main() {
    uint block = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint blocks = pc.count / 32u;
    if (block >= blocks) return;

    uint lane = gl_LocalInvocationID.x;
    float value = uintBitsToFloat(arena.data[pc.input_word + block * 32u + lane]);
    values[lane] = value;
    partial[lane] = abs(value);
    barrier();

    for (uint step = 16u; step > 0u; step >>= 1u) {
        if (lane < step) partial[lane] = max(partial[lane], partial[lane + step]);
        barrier();
    }

    if (lane == 0u) {
        precise float scale = partial[0] == 0.0 ? 0.0 : partial[0] / 127.0;
        raw_scale = scale;
        inverse_scale = partial[0] == 0.0
            ? 0.0
            : divide_finite_normal(127.0, partial[0]);
        float stored_scale = round_f16_rte(scale);
        arena.data[pc.scales_word + block] = floatBitsToUint(stored_scale);
    }
    barrier();

    if (lane < 8u) {
        uint packed = 0u;
        for (uint byte_index = 0u; byte_index < 4u; byte_index++) {
            uint value_index = lane * 4u + byte_index;
            precise float scaled = values[value_index] * inverse_scale;
            int quantized = int(roundEven(scaled));
            quantized = clamp(quantized, -128, 127);
            quantized_values[value_index] = quantized;
            packed |= (uint(quantized) & 0xffu) << (byte_index * 8u);
        }
        arena.data[pc.q8_word + block * 8u + lane] = packed;
    }
    barrier();

    partial_sum[lane] = quantized_values[lane];
    barrier();
    for (uint step = 16u; step > 0u; step >>= 1u) {
        if (lane < step) partial_sum[lane] += partial_sum[lane + step];
        barrier();
    }
    if (lane == 0u) {
        float input_sum = round_f16_rte(float(partial_sum[0]) * raw_scale);
        arena.data[pc.input_sums_word + block] = floatBitsToUint(input_sum);
    }
}
