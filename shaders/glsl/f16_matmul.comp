#version 450
#extension GL_GOOGLE_include_directive : require
#include "f16_rounding.glsl"
#include "f16_dot.glsl"

// Four output rows per workgroup, sixteen lanes each.
//
// One row per workgroup left three quarters of the workgroup idle: the
// reduction modes give a row sixteen lanes (mode 2), eight (mode 8) or one
// (mode 0), and every other thread exited immediately. That also meant one
// warp load instruction fetched a single 32-byte sector, measured 35 GB/s
// against 242 GB/s of memory bandwidth on GB10.
//
// Grouping rows makes every thread useful and every load instruction fetch
// four sectors from four rows, without touching the per-row arithmetic:
// each row still owns the same lanes, walks the same index classes in the
// same order, and reduces through the same tree. The modes and their lane
// counts are what the CPU kernels do, and the GPU has to reproduce them
// bit for bit.
//
// Mode 1 needs 32 lanes per row, so it fits two rows per workgroup.
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC {
    uint input_word;
    uint reduction_mode;
    uint n_in;
    uint elements_per_row;
    uint output0_word; uint rows0; uint output0_stride;
    uint output1_word; uint rows1; uint output1_stride;
    uint output2_word; uint rows2; uint output2_stride;
    uint group_count; uint input_sum_word; uint input_stride; uint q8_stride; uint scales_stride; uint input_sum_stride; uint q8k_stride; uint q8k_scales_stride; uint token_rows;
} pc;

uint weight_word(uint slot, uint index) {
    if (slot == 0u) return w0.data[index];
    if (slot == 1u) return w1.data[index];
    return w2.data[index];
}

uint weight_f16(uint slot, uint index) {
    uint word = weight_word(slot, index >> 1u);
    return (index & 1u) == 0u ? word & 0xffffu : word >> 16u;
}

float f16_decode(uint bits) {
    return unpackHalf2x16(bits).x;
}

// One slot per thread, so each row reduces inside its own sixteen lanes.
shared float partial[64];

void main() {
    uint token_row = gl_WorkGroupID.z / pc.group_count;
    uint slot = gl_WorkGroupID.z % pc.group_count;
    // Each mode needs exactly as many lanes as its CPU reduction uses:
    // 32 for the half-precision tree, 16 for the NEON accumulator, 8 for the
    // AVX2/F16C dot, and one for the scalar walk. Packing rows until the
    // workgroup is full keeps every thread busy.
    uint lanes_per_row = pc.reduction_mode == 1u ? 32u
        : (pc.reduction_mode == 2u ? 16u
        : (pc.reduction_mode == 8u ? 8u : 1u));
    uint rows_per_group = 64u / lanes_per_row;
    uint lane = gl_LocalInvocationID.x;
    uint local = lane % lanes_per_row;
    uint lane_base = lane - local;
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint row = group * rows_per_group + lane / lanes_per_row;
    uint rows = slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2);
    if (slot >= pc.group_count) return;
    // A row past the end still runs the barriers; only its work and its
    // write are skipped.
    bool valid_row = row < rows;

    precise float sum = 0.0;
    uint row_base = row * pc.elements_per_row;
    if (pc.reduction_mode == 1u) {
        if (local < 32u && valid_row) {
            for (uint index = local; index < pc.n_in; index += 32u) {
                float input_value = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]));
                sum = half_fma(input_value, f16_decode(weight_f16(slot, row_base + index)), sum);
            }
        }
        partial[lane] = sum;
        barrier();
        if (local < 8u) {
            precise float a = partial[lane_base + local] + partial[lane_base + local + 16u];
            precise float b = partial[lane_base + local + 8u] + partial[lane_base + local + 24u];
            partial[lane] = round_f16_rte(round_f16_rte(a) + round_f16_rte(b));
        }
        barrier();
        if (local != 0u || !valid_row) return;
        precise float a = partial[lane_base] + partial[lane_base + 4u];
        precise float b = partial[lane_base + 1u] + partial[lane_base + 5u];
        precise float c = partial[lane_base + 2u] + partial[lane_base + 6u];
        precise float d = partial[lane_base + 3u] + partial[lane_base + 7u];
        sum = (a + b) + (c + d);
    } else if (pc.reduction_mode == 2u) {
        if (local < 16u && valid_row) {
            // Four index classes per pass, loaded before any of them is
            // multiplied. The chain order is unchanged -- only the loads move
            // ahead of the multiplies -- but four loads are now in flight
            // instead of one, which is what the sixteen-lane chain needs to
            // keep the memory pipeline busy.
            uint index = local;
            for (; index + 48u < pc.n_in; index += 64u) {
                uint w0 = weight_f16(slot, row_base + index);
                uint w1 = weight_f16(slot, row_base + index + 16u);
                uint w2 = weight_f16(slot, row_base + index + 32u);
                uint w3 = weight_f16(slot, row_base + index + 48u);
                float x0 = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]));
                float x1 = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index + 16u]));
                float x2 = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index + 32u]));
                float x3 = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index + 48u]));
                sum = fma(x0, f16_decode(w0), sum);
                sum = fma(x1, f16_decode(w1), sum);
                sum = fma(x2, f16_decode(w2), sum);
                sum = fma(x3, f16_decode(w3), sum);
            }
            for (; index < pc.n_in; index += 16u) {
                float input_value = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]));
                sum = fma(input_value, f16_decode(weight_f16(slot, row_base + index)), sum);
            }
        }
        partial[lane] = sum;
        barrier();
        if (local != 0u || !valid_row) return;
        precise float a = (partial[lane_base] + partial[lane_base + 4u]) + (partial[lane_base + 8u] + partial[lane_base + 12u]);
        precise float b = (partial[lane_base + 1u] + partial[lane_base + 5u]) + (partial[lane_base + 9u] + partial[lane_base + 13u]);
        precise float c = (partial[lane_base + 2u] + partial[lane_base + 6u]) + (partial[lane_base + 10u] + partial[lane_base + 14u]);
        precise float d = (partial[lane_base + 3u] + partial[lane_base + 7u]) + (partial[lane_base + 11u] + partial[lane_base + 15u]);
        sum = (a + b) + (c + d);
    } else if (pc.reduction_mode == 8u) {
        // Match the CPU AVX2/F16C dot, including its separate four-value tail.
        uint vector_end = pc.n_in / 8u * 8u;
        if (local < 8u && valid_row) {
            precise float acc = 0.0;
            for (uint offset = local; offset < vector_end; offset += 8u) {
                float x = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + offset]));
                acc = fma(x, f16_decode(weight_f16(slot, row_base + offset)), acc);
            }
            partial[lane] = acc;
        }
        barrier();
        if (local != 0u || !valid_row) return;
        sum = ((partial[lane_base] + partial[lane_base + 4u]) + (partial[lane_base + 1u] + partial[lane_base + 5u]))
            + ((partial[lane_base + 2u] + partial[lane_base + 6u]) + (partial[lane_base + 3u] + partial[lane_base + 7u]));
        uint index = vector_end;
        if (index + 4u <= pc.n_in) {
            precise float tail[4];
            for (uint k = 0u; k < 4u; k++) {
                float x = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index + k]));
                tail[k] = x * f16_decode(weight_f16(slot, row_base + index + k));
            }
            sum += (tail[0] + tail[1]) + (tail[2] + tail[3]);
            index += 4u;
        }
        for (; index < pc.n_in; index++) {
            float x = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]));
            sum += x * f16_decode(weight_f16(slot, row_base + index));
        }
    } else {
        if (local != 0u || !valid_row) return;
        for (uint index = 0u; index < pc.n_in; index++) {
            float input_value = round_f16_rte(uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]));
            float weight_value = f16_decode(weight_f16(slot, row_base + index));
            sum += input_value * weight_value;
        }
    }

    uint output_word = slot == 0u
        ? pc.output0_word
        : (slot == 1u ? pc.output1_word : pc.output2_word);
    arena.data[output_word + token_row * (slot == 0u ? pc.output0_stride : (slot == 1u ? pc.output1_stride : pc.output2_stride)) + row] = floatBitsToUint(sum);
}
