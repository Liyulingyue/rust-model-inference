#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer Weights { float data[]; } weights;
layout(push_constant) uniform PC {
    uint op; uint a; uint b; uint c; uint n; uint width;
    uint p0; uint p1; uint p2; uint p3; uint p4; uint p5;
    float factor; uint half_kv;
} pc;
#include "exp_f64.glsl"
#include "f16_rounding.glsl"
#include "f32_divide.glsl"
#include "f32_norm.glsl"
float get(uint i) { return uintBitsToFloat(arena.data[i]); }
void put(uint i, float v) { arena.data[i] = floatBitsToUint(v); }
float half_round(float v) { return round_f16_rte(v); }
uint cache_index(uint j, uint head, uint d) {
    return ((pc.p4 + j) % pc.p3) * pc.p1 * pc.width + head * pc.width + d;
}
shared double norm_sums[64];
shared float norm_scale;
shared float quant_max[64];
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (pc.op == 13u) {
        uint lane = gl_LocalInvocationID.x;
        uint block = gl_WorkGroupID.x;
        uint base = block * 256u + lane * 4u;
        float maximum = 0.0;
        for (uint j = 0u; j < 4u; ++j) {
            float v = get(pc.a + base + j);
            if (abs(v) > abs(maximum)) maximum = v;
        }
        quant_max[lane] = maximum;
        barrier();
        if (lane == 0u) {
            maximum = 0.0;
            // Consecutive four-value lanes retain the first signed maximum on ties.
            for (uint j = 0u; j < 64u; ++j)
                if (abs(quant_max[j]) > abs(maximum)) maximum = quant_max[j];
            norm_scale = maximum == 0.0 ? 0.0 : divide_finite_normal(-127.0, maximum);
            put(pc.c + block, maximum == 0.0 ? 0.0 : divide_finite_normal(1.0, norm_scale));
        }
        barrier();
        uint packed = 0u;
        for (uint j = 0u; j < 4u; ++j) {
            precise float scaled = norm_scale * get(pc.a + base + j);
            int q = int((floatBitsToUint(scaled + 12582912.0) & 0x007fffffu) - 0x00400000u);
            packed |= uint(clamp(q, -127, 127) & 255) << (j * 8u);
        }
        arena.data[pc.b + block * 64u + lane] = packed;
    } else if (pc.op == 0u) {
        uint head = gl_WorkGroupID.x, lane = gl_LocalInvocationID.x;
        if (head >= pc.n) return;
        uint base = pc.a + head * pc.width;
        precise double sum = 0.0lf;
        for (uint d = lane; d < pc.width; d += 64u) {
            precise float square = get(base + d) * get(base + d);
            sum += double(square);
        }
        norm_sums[lane] = sum;
        barrier();
        if (lane == 0u) {
            sum = 0.0lf;
            for (uint j = 0u; j < 64u; ++j) sum += norm_sums[j];
            precise float mean = float(sum / double(pc.width));
            norm_scale = inverse_sqrt_f32(mean + divide_finite_normal(1e-6, float(pc.width)));
        }
        barrier();
        for (uint d = lane; d < pc.width; d += 64u) {
            precise float v = get(base + d) * norm_scale;
            v *= pc.factor;
            put(base + d, v);
        }
    } else if (pc.op == 1u || pc.op == 2u) {
        if (i >= pc.n) return;
        precise float v = get(pc.a + i);
        if (pc.op == 2u) v += get(pc.b + i);
        put(pc.c + i, v);
    } else if (pc.op == 3u) {
        if (i >= pc.n / 2u) return;
        uint d = i % (pc.width / 2u);
        uint a = pc.a + (i / (pc.width / 2u)) * pc.width + d;
        float cs = get(pc.b + d), sn = get(pc.b + pc.width / 2u + d);
        float x = get(a), y = get(a + pc.width / 2u);
        precise float xr = x * cs - y * sn;
        precise float yr = x * sn + y * cs;
        put(a, xr); put(a + pc.width / 2u, yr);
    } else if (pc.op == 4u) {
        if (i >= pc.n) return;
        precise float scale = weights.data[pc.p5 + i] * pc.factor;
        precise float v = get(pc.a + i) * (scale * scale);
        put(pc.a + i, pc.half_kv != 0u ? half_round(v) : v);
    } else if (pc.op == 5u) {
        if (i >= pc.n) return;
        float k = get(pc.a + i), v = get(pc.b + i);
        put(pc.c + i, pc.half_kv != 0u ? half_round(k) : k);
        put(pc.p0 + i, pc.half_kv != 0u ? half_round(v) : v);
    } else if (pc.op == 6u) {
        if (i >= pc.n * pc.p0) return;
        uint head = i / pc.n, j = i % pc.n;
        uint kh = head / (pc.p0 / pc.p1);
        precise double sum = 0.0lf;
        for (uint d = 0u; d < pc.width; ++d) {
            precise float term = get(pc.a + head * pc.width + d) * get(pc.b + cache_index(j, kh, d));
            sum += double(term);
        }
        precise float result = float(sum) * pc.factor;
        put(pc.c + i, result);
    } else if (pc.op == 7u) {
        if (i >= pc.p0) return;
        uint base = pc.a + i * pc.n;
        float mx = get(base);
        for (uint j = 1u; j < pc.n; ++j) mx = max(mx, get(base + j));
        precise double sum = 0.0lf;
        for (uint j = 0u; j < pc.n; ++j) {
            float e = exp_f64(get(base + j) - mx);
            put(base + j, e); sum += double(e);
        }
        float scale = float(1.0lf / sum);
        for (uint j = 0u; j < pc.n; ++j) {
            precise float v = get(base + j) * scale;
            put(base + j, pc.half_kv != 0u ? half_round(v) : v);
        }
    } else if (pc.op == 8u) {
        if (i >= pc.p0 * pc.width) return;
        uint head = i / pc.width, d = i % pc.width;
        uint kh = head / (pc.p0 / pc.p1);
        precise double sum = 0.0lf;
        for (uint j = 0u; j < pc.n; ++j) {
            precise float term = get(pc.a + head * pc.n + j) * get(pc.b + cache_index(j, kh, d));
            sum += double(term);
        }
        put(pc.c + i, float(sum));
    } else if (pc.op == 9u) {
        if (i >= pc.n) return;
        precise float scale = weights.data[pc.p5 + i] * pc.factor;
        precise float exponent = -get(pc.b + i) * (scale * scale);
        precise float gate = divide_finite_normal(1.0, 1.0 + exp_f64(exponent));
        precise float v = get(pc.a + i) * gate;
        put(pc.a + i, v);
    } else if (pc.op == 10u) {
        if (i >= pc.n) return;
        precise float gate = get(pc.a + i) * (weights.data[pc.p5 + i] * pc.factor);
        precise float up = get(pc.b + i) * (weights.data[pc.p5 + pc.n + i] * pc.factor);
        precise float activation = divide_finite_normal(gate, 1.0 + exp_f64(-gate));
        precise float v = activation * up;
        put(pc.b + i, v);
    } else if (pc.op == 11u) {
        if (i >= pc.n) return;
        precise float a = get(pc.a + i), b = get(pc.b + i);
        precise float v = a + abs(weights.data[i]) * (b - a);
        put(pc.a + i, v);
    } else if (pc.op == 12u) {
        if (i >= pc.n) return;
        precise float v = get(pc.a + i) * weights.data[i];
        put(pc.a + i, v);
    }
}
