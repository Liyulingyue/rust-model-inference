#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint target_word;
    uint addition_word;
    uint count;
} pc;

void main() {
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint index = group * 64u + gl_LocalInvocationID.x;
    if (index >= pc.count) return;
    float target = uintBitsToFloat(arena.data[pc.target_word + index]);
    float addition = uintBitsToFloat(arena.data[pc.addition_word + index]);
    arena.data[pc.target_word + index] = floatBitsToUint(target + addition);
}
