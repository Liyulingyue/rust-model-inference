#version 450
#extension GL_EXT_spirv_intrinsics : require
// glslang 15 lacks the GLSL dot extension; emit its signed packed SPIR-V instruction.
spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6018, 6019], id = 4450)
int dotPacked4x8EXT(int a, int b, spirv_literal uint format);

layout(local_size_x = 64) in;

// The weight buffer holds the *transposed* Q8_0 layout:
//
//   for every tile of 64 output rows:
//     for every 32-value block:
//       payload: the int8 payload of every row of the tile, contiguous.
//                Block b, row r of the tile lives at
//                tile_base + b * 64 * 34 + r * 32.
//       scales:  the f16 scale of every row of the tile, right after the
//                payload, at tile_base + b * 64 * 34 + 64 * 32 + r * 2.
//
// ggml's own layout puts the blocks of one output row together, so a warp
// reads 32 sectors one row apart and every 4-byte load straddles a block
// boundary. Here the rows of a tile are neighbours, so a warp reads one
// contiguous run and the payload loads are aligned. The tile is the unit a
// workgroup works in, so the runs stay sequential over the whole tile.
layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC {
    uint q8_word;
    uint scales_word;
    uint n_in;
    uint blocks_per_row;
    uint output0_word; uint rows0; uint output0_stride;
    uint output1_word; uint rows1; uint output1_stride;
    uint output2_word; uint rows2; uint output2_stride;
    uint group_count; uint reduction_mode; uint input_stride; uint q8_stride; uint scales_stride; uint input_sum_stride; uint q8k_stride; uint q8k_scales_stride; uint token_rows;
    uint expert_count; uint expert_ids_word; uint expert_used; uint expert_slot;
} pc;

const uint CHUNK_BLOCKS = 64u;
const uint PAYLOAD_BYTES = 32u;
const uint BLOCK_BYTES = 34u;
const uint TILE_ROWS = 64u;
shared uint input_words[CHUNK_BLOCKS * 8u];
shared float input_scales[CHUNK_BLOCKS];

float f16_decode(uint bits) {
    uint sign = (bits >> 15u) & 1u;
    int exponent = int((bits >> 10u) & 0x1fu);
    uint mantissa = (bits >> 0u) & 0x3ffu;
    float value;
    if (exponent == 0) {
        value = (float(mantissa) / 1024.0) * exp2(-14.0);
    } else if (exponent == 31) {
        return 0.0;
    } else {
        value = (1.0 + float(mantissa) / 1024.0) * exp2(float(exponent - 15));
    }
    return sign == 0u ? value : -value;
}

uint weight_word(uint slot, uint index) {
    if (slot == 0u) return w0.data[index];
    if (slot == 1u) return w1.data[index];
    return w2.data[index];
}

uint rows_of(uint slot) {
    return slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2);
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint token_row = gl_WorkGroupID.z / pc.group_count;
    uint slot = gl_WorkGroupID.z % pc.group_count;
    if (slot >= pc.group_count) return;
    uint row = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 64u + lane;
    uint rows = rows_of(slot);
    uint read_row = min(row, rows - 1u);
    uint blocks_per_row = pc.blocks_per_row;

    // The expert index is folded into a temporary and added unconditionally.
    // Adding a constant inside the branch makes driver 580.173.02 on GB10
    // trap inside libnvidia-gpucomp while compiling this shader (SIGTRAP in
    // vkCreateComputePipelines); the temporary form compiles and the value is
    // identical, because a non-MoE stack keeps expert_count at zero.
    uint expert_index = 0u;
    if (pc.expert_count != 0u) {
        uint expert = arena.data[pc.expert_ids_word + token_row * pc.expert_used + pc.expert_slot];
        expert_index = min(expert, pc.expert_count - 1u);
    }
    // The transposed layout groups the output rows into tiles of TILE_ROWS
    // rows, and a tile holds blocks_per_row blocks of TILE_ROWS rows.
    uint tile = read_row / TILE_ROWS;
    uint tile_row = read_row % TILE_ROWS;
    uint tile_bytes = blocks_per_row * TILE_ROWS * BLOCK_BYTES;
    uint tile_base = tile * tile_bytes;
    uint payload_base = tile_base + tile_row * PAYLOAD_BYTES;
    uint scale_base = tile_base + TILE_ROWS * PAYLOAD_BYTES + tile_row * 2u;

    precise float acc[8];
    for (uint group = 0u; group < 8u; group++) acc[group] = 0.0;
    for (uint chunk = 0u; chunk < blocks_per_row; chunk += CHUNK_BLOCKS) {
        uint blocks = min(CHUNK_BLOCKS, blocks_per_row - chunk);
        for (uint index = lane; index < blocks * 8u; index += 64u) {
            input_words[index] = arena.data[pc.q8_word + token_row * pc.q8_stride + chunk * 8u + index];
        }
        if (lane < blocks) {
            input_scales[lane] = uintBitsToFloat(arena.data[pc.scales_word + token_row * pc.scales_stride + chunk + lane]);
        }
        barrier();
        for (uint local_block = 0u; local_block < blocks; local_block++) {
            uint block = chunk + local_block;
            // Payload: 32 contiguous bytes for this (block, row).
            uint payload_byte = payload_base + block * TILE_ROWS * BLOCK_BYTES;
            uint scale_byte = scale_base + block * TILE_ROWS * BLOCK_BYTES;
            uint scale_word = weight_word(slot, scale_byte >> 2u);
            uint scale_shift = (scale_byte & 3u) * 8u;
            uint scale_bits = (scale_shift == 0u)
                ? scale_word & 0xffffu
                : ((scale_word >> scale_shift) & 0xffffu);
            float weight_scale = f16_decode(scale_bits);
            float input_scale = input_scales[local_block];
            precise float block_scale = weight_scale * input_scale;
            uint payload_word = payload_byte >> 2u;
            int block_dot = 0;
            for (uint group = 0u; group < 8u; group++) {
                uint packed = weight_word(slot, payload_word + group);
                uint input_value = input_words[local_block * 8u + group];
                int dot = dotPacked4x8EXT(int(packed), int(input_value), 0u);
                if (pc.reduction_mode == 8u) acc[group] = fma(float(dot), block_scale, acc[group]);
                else block_dot += dot;
            }
            precise float product = float(block_dot) * block_scale;
            if (pc.reduction_mode != 8u) {
                acc[0] = pc.reduction_mode == 0u ? acc[0] + product : fma(float(block_dot), block_scale, acc[0]);
            }
        }
        if (chunk + CHUNK_BLOCKS < blocks_per_row) barrier();
    }
    if (row >= rows) return;
    precise float sum01 = (acc[0] + acc[4]) + (acc[1] + acc[5]);
    precise float sum23 = (acc[2] + acc[6]) + (acc[3] + acc[7]);
    precise float sum = pc.reduction_mode == 8u ? sum01 + sum23 : acc[0];
    uint output_word = slot == 0u
        ? pc.output0_word
        : (slot == 1u ? pc.output1_word : pc.output2_word);
    arena.data[output_word + token_row * (slot == 0u ? pc.output0_stride : (slot == 1u ? pc.output1_stride : pc.output2_stride)) + row] = floatBitsToUint(sum);
}
