#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer DtBias { uint data[]; } dt_bias;
layout(std430, binding = 2) readonly buffer AWeight { uint data[]; } a_weight;
layout(std430, binding = 3) readonly buffer NormWeight { uint data[]; } norm_weight;
layout(push_constant) uniform PC {
    uint q_word;
    uint k_word;
    uint v_word;
    uint z_word;
    uint beta_word;
    uint alpha_word;
    uint output_word;
    uint state_word;
    uint layer;
    uint k_heads;
    uint v_heads;
    uint head_dim;
    float eps;
    uint rows;
    uint reduction_lanes;
} pc;

shared float output_values[128];
shared float inverse_rms;
shared float decay;
shared float beta_value;

#include "exp_approx_neon.glsl"

#include "f32_dot.glsl"
#include "exp_accurate.glsl"
#include "f32_divide.glsl"
#include "f32_norm.glsl"

void main() {
    uint value_head = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (value_head >= pc.v_heads) return;
    uint lane = gl_LocalInvocationID.x;
    uint key_head = value_head % pc.k_heads;

    uint state_head = pc.state_word + (pc.layer * pc.v_heads + value_head) * pc.head_dim * pc.head_dim;
    // Existing head_dim <= 128 bounds two state rows per lane.
    float state_values[256];
    for (uint row = lane; row < pc.head_dim; row += 64u) {
        for (uint column = 0u; column < pc.head_dim; column++) {
            state_values[(row / 64u) * pc.head_dim + column] =
                uintBitsToFloat(arena.data[state_head + row * pc.head_dim + column]);
        }
    }
    for (uint token = 0u; token < pc.rows; token++) {
        if (lane == 0u) {
            float beta_raw = uintBitsToFloat(arena.data[pc.beta_word + token * pc.v_heads + value_head]);
            beta_value = divide_finite_normal(1.0, 1.0 + exp_accurate(-beta_raw));
            float alpha_raw = uintBitsToFloat(arena.data[pc.alpha_word + token * pc.v_heads + value_head]);
            precise float biased = alpha_raw + uintBitsToFloat(dt_bias.data[value_head]);
            float softplus = biased > 20.0 ? biased : log(1.0 + exp_accurate(biased));
            precise float gate = softplus * uintBitsToFloat(a_weight.data[value_head]);
            decay = exp_accurate(gate);
        }
        barrier();

        for (uint row = lane; row < pc.head_dim; row += 64u) {
            uint row_base = (row / 64u) * pc.head_dim;
            uint key_base = pc.k_word + (token * pc.k_heads + key_head) * pc.head_dim;
            precise float key_acc[16];
            precise float state_key = 0.0;
            uint vector_end = pc.reduction_lanes == 0u ? 0u
                : pc.head_dim / pc.reduction_lanes * pc.reduction_lanes;
            for (uint i = 0u; i < 16u; i++) key_acc[i] = 0.0;
            for (uint column = 0u; column < pc.head_dim; column++) {
                precise float state = state_values[row_base + column] * decay;
                state_values[row_base + column] = state;
                float key = uintBitsToFloat(arena.data[key_base + column]);
                if (column < vector_end) {
                    uint stream = column % pc.reduction_lanes;
                    key_acc[stream] = fma(state, key, key_acc[stream]);
                }
            }
            if (pc.reduction_lanes != 0u) state_key = reduce_f32_dot(key_acc, pc.reduction_lanes);
            for (uint column = vector_end; column < pc.head_dim; column++) {
                precise float term = state_values[row_base + column]
                    * uintBitsToFloat(arena.data[key_base + column]);
                state_key += term;
            }
            float value = uintBitsToFloat(
                arena.data[pc.v_word + (token * pc.v_heads + value_head) * pc.head_dim + row]
            );
            precise float delta = (value - state_key) * beta_value;
            precise float output_acc[16];
            for (uint i = 0u; i < 16u; i++) output_acc[i] = 0.0;
            precise float output_value = 0.0;
            uint q_base = pc.q_word + (token * pc.k_heads + key_head) * pc.head_dim;
            for (uint column = 0u; column < pc.head_dim; column++) {
                float key = uintBitsToFloat(arena.data[key_base + column]);
                precise float term = key * delta;
                precise float state = pc.reduction_lanes != 0u && column < pc.head_dim / 4u * 4u
                    ? fma(key, delta, state_values[row_base + column])
                    : state_values[row_base + column] + term;
                state_values[row_base + column] = state;
                float query = uintBitsToFloat(arena.data[q_base + column]);
                if (column < vector_end) {
                    uint stream = column % pc.reduction_lanes;
                    output_acc[stream] = fma(state, query, output_acc[stream]);
                }
            }
            if (pc.reduction_lanes != 0u) output_value = reduce_f32_dot(output_acc, pc.reduction_lanes);
            for (uint column = vector_end; column < pc.head_dim; column++) {
                precise float term = state_values[row_base + column]
                    * uintBitsToFloat(arena.data[q_base + column]);
                output_value += term;
            }
            output_values[row] = output_value * inverse_sqrt_f32(float(pc.head_dim));
        }
        barrier();

        if (lane == 0u) {
            precise float sum = 0.0;
            precise float correction = 0.0;
            for (uint index = 0u; index < pc.head_dim; index++) {
                float square = output_values[index] * output_values[index];
                precise float next = sum + square;
                correction += sum >= square
                    ? (sum - next) + square
                    : (square - next) + sum;
                sum = next;
            }
            inverse_rms = inverse_sqrt_f32((sum + correction) / float(pc.head_dim) + pc.eps);
        }
        barrier();

        for (uint row = lane; row < pc.head_dim; row += 64u) {
            precise float normalized = output_values[row] * inverse_rms
                * uintBitsToFloat(norm_weight.data[row]);
            float gate = uintBitsToFloat(
                arena.data[pc.z_word + (token * pc.v_heads + value_head) * pc.head_dim + row]
            );
            precise float activated = divide_finite_normal(gate, 1.0 + exp_approx_neon(-gate));
            arena.data[pc.output_word + (token * pc.v_heads + value_head) * pc.head_dim + row] =
                floatBitsToUint(normalized * activated);
        }
        barrier();
    }
    for (uint row = lane; row < pc.head_dim; row += 64u) {
        for (uint column = 0u; column < pc.head_dim; column++) {
            arena.data[state_head + row * pc.head_dim + column] =
                floatBitsToUint(state_values[(row / 64u) * pc.head_dim + column]);
        }
    }
}
