#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : enable
#include "f32_divide.glsl"
#include "f32_norm.glsl"

// RMS normalisation, one workgroup per row.
//
// The reduction is a serial walk by lane 0 in the CPU AVX2 kernel's exact
// order: f32 squares widened to double, grouped per 8 elements as
// ((s0+s2)+(s1+s3)) + ((s4+s6)+(s5+s7)), each group folded into one
// sequential double accumulator, and the mean divided in double before the
// single rounding to f32. Anything else -- the 64-lane Kahan tree this
// replaced, which was faster -- is a different summation: at width 2560 its
// sum-of-squares disagrees with the CPU accumulator by an ULP often enough
// to flip q8 quantization bytes and break the Qwen3-4B contract, while the
// rows where no byte flips stay bit-identical and hide the drift.
//
// The transcription needs `shaderFloat64` (the same rule as the softmax
// glibc expf parity): devices without it reject the recording and fall back
// to the CPU path instead of quietly computing different values.

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer Weight { uint data[]; } weight;
layout(push_constant) uniform PC {
    uint input_word;
    uint weight_word;
    uint output_word;
    uint count;
    uint vectors;
    float eps;
    uint input_stride;
    uint output_stride;
} pc;

shared float inverse_rms;

void main() {
    uint vector_index = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (vector_index >= pc.vectors) return;
    uint lane = gl_LocalInvocationID.x;
    uint base = vector_index * pc.input_stride;
    uint output_base = vector_index * pc.output_stride;

    precise double acc = 0.0lf;
    precise double tail = 0.0lf;
    if (lane == 0u) {
        uint i = 0u;
        for (; i + 8u <= pc.count; i += 8u) {
            precise float v0 = uintBitsToFloat(arena.data[pc.input_word + base + i + 0u]);
            precise float v1 = uintBitsToFloat(arena.data[pc.input_word + base + i + 1u]);
            precise float v2 = uintBitsToFloat(arena.data[pc.input_word + base + i + 2u]);
            precise float v3 = uintBitsToFloat(arena.data[pc.input_word + base + i + 3u]);
            precise float v4 = uintBitsToFloat(arena.data[pc.input_word + base + i + 4u]);
            precise float v5 = uintBitsToFloat(arena.data[pc.input_word + base + i + 5u]);
            precise float v6 = uintBitsToFloat(arena.data[pc.input_word + base + i + 6u]);
            precise float v7 = uintBitsToFloat(arena.data[pc.input_word + base + i + 7u]);
            precise double s0 = double(v0 * v0);
            precise double s1 = double(v1 * v1);
            precise double s2 = double(v2 * v2);
            precise double s3 = double(v3 * v3);
            precise double s4 = double(v4 * v4);
            precise double s5 = double(v5 * v5);
            precise double s6 = double(v6 * v6);
            precise double s7 = double(v7 * v7);
            precise double lo = (s0 + s2) + (s1 + s3);
            precise double hi = (s4 + s6) + (s5 + s7);
            acc = acc + (lo + hi);
        }
        for (; i < pc.count; i++) {
            precise float value = uintBitsToFloat(arena.data[pc.input_word + base + i]);
            tail = tail + double(value * value);
        }
        acc = acc + tail;
        precise double mean = acc / double(pc.count);
        inverse_rms = inverse_sqrt_f32(float(mean) + pc.eps);
    }
    barrier();
    for (uint index = lane; index < pc.count; index += 64u) {
        float value = uintBitsToFloat(arena.data[pc.input_word + base + index]);
        float scale = uintBitsToFloat(weight.data[pc.weight_word + index]);
        precise float normalized = value * inverse_rms * scale;
        arena.data[pc.output_word + output_base + index] = floatBitsToUint(normalized);
    }
}
