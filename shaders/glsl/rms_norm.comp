#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer Weight { uint data[]; } weight;
layout(push_constant) uniform PC {
    uint input_word;
    uint weight_word;
    uint output_word;
    uint count;
    uint vectors;
    float eps;
} pc;

shared float inverse_rms;

void main() {
    uint vector_index = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (vector_index >= pc.vectors) return;
    uint lane = gl_LocalInvocationID.x;
    uint base = vector_index * pc.count;
    if (lane == 0u) {
        precise float sum = 0.0;
        precise float correction = 0.0;
        for (uint index = 0u; index < pc.count; index++) {
            float value = uintBitsToFloat(arena.data[pc.input_word + base + index]);
            float square = value * value;
            precise float next = sum + square;
            correction += sum >= square
                ? (sum - next) + square
                : (square - next) + sum;
            sum = next;
        }
        precise float mean_square = (sum + correction) / float(pc.count) + pc.eps;
        precise float root = sqrt(mean_square);
        precise float root_residual = fma(-root, root, mean_square);
        root = fma(root_residual, 0.5 / root, root);
        precise float reciprocal = 1.0 / root;
        precise float reciprocal_residual = fma(-root, reciprocal, 1.0);
        inverse_rms = fma(reciprocal_residual, reciprocal, reciprocal);
    }
    barrier();
    for (uint index = lane; index < pc.count; index += 64u) {
        float value = uintBitsToFloat(arena.data[pc.input_word + base + index]);
        float scale = uintBitsToFloat(weight.data[pc.weight_word + index]);
        arena.data[pc.output_word + base + index] = floatBitsToUint(value * inverse_rms * scale);
    }
}
