#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer ConvWeight { uint data[]; } conv_weight;
layout(push_constant) uniform PC {
    uint qkv_word;
    uint q_word;
    uint k_word;
    uint v_word;
    uint state_word;
    uint layer;
    uint conv_dim;
    uint key_dim;
    uint value_dim;
    uint d_conv;
    uint k_heads;
    uint v_heads;
    uint head_dim;
    float eps;
    uint phase;
    uint rows;
} pc;

shared float inverse_q;
shared float inverse_k;

#include "exp_approx_neon.glsl"
#include "f32_divide.glsl"
#include "f32_norm.glsl"

void main() {
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint lane = gl_LocalInvocationID.x;
    if (pc.phase == 0u) {
        uint channel = group * 64u + lane;
        if (channel >= pc.conv_dim) return;
        uint state_base = pc.state_word + pc.layer * pc.d_conv * pc.conv_dim;
        // Each channel scans prompt rows in order; raw QKV stays available for later taps.
        for (uint row = 0u; row < pc.rows; row++) {
            precise float value = 0.0;
            for (uint tap = 0u; tap < pc.d_conv; tap++) {
                uint source = row + tap + 1u;
                float input_value = uintBitsToFloat(source < pc.d_conv
                    ? arena.data[state_base + source * pc.conv_dim + channel]
                    : arena.data[pc.qkv_word + (source - pc.d_conv) * pc.conv_dim + channel]);
                precise float term = uintBitsToFloat(conv_weight.data[channel * pc.d_conv + tap]) * input_value;
                value += term;
            }
            precise float activated = divide_finite_normal(value, 1.0 + exp_approx_neon(-value));
            uint output_word = channel < pc.key_dim
                ? pc.q_word + row * pc.key_dim + channel
                : channel < 2u * pc.key_dim
                    ? pc.k_word + row * pc.key_dim + channel - pc.key_dim
                    : pc.v_word + row * pc.value_dim + channel - 2u * pc.key_dim;
            arena.data[output_word] = floatBitsToUint(activated);
        }
        // Only the final history is persistent. Forward copying also handles rows < taps.
        for (uint tap = 0u; tap < pc.d_conv; tap++) {
            uint source = pc.rows + tap;
            arena.data[state_base + tap * pc.conv_dim + channel] = source < pc.d_conv
                ? arena.data[state_base + source * pc.conv_dim + channel]
                : arena.data[pc.qkv_word + (source - pc.d_conv) * pc.conv_dim + channel];
        }
        return;
    }

    uint head = group;
    for (uint row = 0u; row < pc.rows; row++) {
        if (lane == 0u && head < pc.k_heads) {
            precise float q_sum = 0.0;
            precise float q_correction = 0.0;
            precise float k_sum = 0.0;
            precise float k_correction = 0.0;
            uint q_base = pc.q_word + row * pc.key_dim + head * pc.head_dim;
            uint k_base = pc.k_word + row * pc.key_dim + head * pc.head_dim;
            for (uint index = 0u; index < pc.head_dim; index++) {
                float q_value = uintBitsToFloat(arena.data[q_base + index]);
                float q_square = q_value * q_value;
                precise float q_next = q_sum + q_square;
                q_correction += q_sum >= q_square
                    ? (q_sum - q_next) + q_square
                    : (q_square - q_next) + q_sum;
                q_sum = q_next;
                float k_value = uintBitsToFloat(arena.data[k_base + index]);
                float k_square = k_value * k_value;
                precise float k_next = k_sum + k_square;
                k_correction += k_sum >= k_square
                    ? (k_sum - k_next) + k_square
                    : (k_square - k_next) + k_sum;
                k_sum = k_next;
            }
            inverse_q = divide_finite_normal(1.0, max(sqrt_f32(q_sum + q_correction), pc.eps));
            inverse_k = divide_finite_normal(1.0, max(sqrt_f32(k_sum + k_correction), pc.eps));
        }
        barrier();

        if (head < pc.k_heads) {
            for (uint index = lane; index < pc.head_dim; index += 64u) {
                uint source_q = pc.q_word + row * pc.key_dim + head * pc.head_dim + index;
                uint source_k = pc.k_word + row * pc.key_dim + head * pc.head_dim + index;
                arena.data[pc.q_word + row * pc.key_dim + head * pc.head_dim + index] = floatBitsToUint(
                    uintBitsToFloat(arena.data[source_q]) * inverse_q
                );
                arena.data[pc.k_word + row * pc.key_dim + head * pc.head_dim + index] = floatBitsToUint(
                    uintBitsToFloat(arena.data[source_k]) * inverse_k
                );
            }
        }
        barrier();
    }
}
