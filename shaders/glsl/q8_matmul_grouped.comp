#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC {
    uint q8_word;
    uint scales_word;
    uint n_in;
    uint blocks_per_row;
    uint output0_word;
    uint rows0;
    uint output1_word;
    uint rows1;
    uint output2_word;
    uint rows2;
    uint group_count;
    uint unused;
} pc;

shared uint input_words[4096];

float f16_decode(uint bits) {
    uint sign = (bits >> 15u) & 1u;
    int exponent = int((bits >> 10u) & 0x1fu);
    uint mantissa = bits & 0x3ffu;
    float value;
    if (exponent == 0) {
        value = (float(mantissa) / 1024.0) * exp2(-14.0);
    } else if (exponent == 31) {
        return 0.0;
    } else {
        value = (1.0 + float(mantissa) / 1024.0) * exp2(float(exponent - 15));
    }
    return sign == 0u ? value : -value;
}

int i8_of(uint word, uint byte_index) {
    uint byte_value = (word >> (byte_index * 8u)) & 0xffu;
    return byte_value >= 128u ? int(byte_value) - 256 : int(byte_value);
}

uint weight_word(uint slot, uint index) {
    if (slot == 0u) return w0.data[index];
    if (slot == 1u) return w1.data[index];
    return w2.data[index];
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint input_word_count = pc.blocks_per_row * 8u;
    for (uint index = lane; index < input_word_count; index += 64u) {
        input_words[index] = arena.data[pc.q8_word + index];
    }
    barrier();

    uint slot = gl_WorkGroupID.z;
    if (slot >= pc.group_count) return;
    uint row = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint rows = slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2);
    if (row >= rows) return;
    if (lane != 0u) return;

    uint row_offset = row * pc.blocks_per_row * 34u;
    float sum = 0.0;
    for (uint block = 0u; block < pc.blocks_per_row; block++) {
        uint byte_offset = row_offset + block * 34u;
        uint scale_word = weight_word(slot, byte_offset >> 2u);
        uint scale_bits = (byte_offset & 3u) == 0u
            ? scale_word & 0xffffu
            : (scale_word >> 16u) & 0xffffu;
        float weight_scale = f16_decode(scale_bits);
        int dot = 0;
        uint body = byte_offset + 2u;
        for (uint group = 0u; group < 8u; group++) {
            uint group_offset = body + group * 4u;
            uint first = weight_word(slot, group_offset >> 2u);
            uint second = weight_word(slot, (group_offset >> 2u) + 1u);
            uint shift = (group_offset & 3u) * 8u;
            uint packed = shift == 0u ? first : ((first >> shift) | (second << (32u - shift)));
            uint input_value = input_words[block * 8u + group];
            dot += i8_of(packed, 0u) * i8_of(input_value, 0u)
                + i8_of(packed, 1u) * i8_of(input_value, 1u)
                + i8_of(packed, 2u) * i8_of(input_value, 2u)
                + i8_of(packed, 3u) * i8_of(input_value, 3u);
        }
        float input_scale = uintBitsToFloat(arena.data[pc.scales_word + block]);
        float scale = weight_scale * input_scale;
        sum = fma(float(dot), scale, sum);
    }

    uint output_word = slot == 0u
        ? pc.output0_word
        : (slot == 1u ? pc.output1_word : pc.output2_word);
    arena.data[output_word + row] = floatBitsToUint(sum);
}
