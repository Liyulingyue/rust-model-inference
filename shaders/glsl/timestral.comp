#version 450
#extension GL_GOOGLE_include_directive : require
#include "exp_accurate.glsl"

layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint mode;
    uint a; uint b; uint c; uint d; uint e; uint f;
    uint rows; uint enc; uint seq; uint context; uint covariates; uint time;
    uint d_model; uint num_heads; uint hd; uint mlp_hidden_dim;
} pc;

float load(uint i) { return uintBitsToFloat(arena.data[i]); }
void store(uint i, float v) { arena.data[i] = floatBitsToUint(v); }

bool allowed(uint row, uint slot, uint j) {
    if (pc.time == 0u) {
        if (row == j) return true;
        uint role_q = uint(load(pc.f+row)), role_k = uint(load(pc.f+j));
        return (slot >= pc.enc || load(pc.e+j*pc.enc+slot) != 0.0)
            && !(role_q != 0u && role_k == 0u) && !(role_q == 2u && role_k != 2u);
    }
    bool valid = j < pc.enc && load(pc.e+row*pc.enc+j) != 0.0;
    if (slot < pc.enc) {
        return j < pc.enc && ((valid && (load(pc.f+row) == 2.0 || j <= slot)) || j == slot);
    }
    uint p = slot-pc.enc;
    if (pc.covariates == 0u) return j < pc.enc ? valid : j-pc.enc <= p;
    if (j < pc.enc) return p >= pc.context && j < pc.context && valid;
    uint kp = j-pc.enc;
    return kp == p || (p >= pc.context && kp >= pc.context && kp <= p);
}

shared float partial[64];
shared float alpha, beta, denominator, maximum;

void main() {
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y*gl_NumWorkGroups.x;
    uint lane = gl_LocalInvocationID.x;
    uint index = group*64u + lane;
    uint count = pc.rows*pc.seq;
    uint d = pc.d_model;
    uint heads = pc.num_heads;
    uint head_dim = pc.hd;
    uint qkv_stride = 3u * d;
    uint v_offset = 2u * d;
    uint rope_hd_half = head_dim / 2u;
    uint rope_coeffs = head_dim / 2u;

    if (pc.mode == 0u) {
        // QKV projection: read fused [n, 3*d], write Q/K/V separate [n, d] each.
        // Fused layout: [token, dim_in_head, head] for Q, then K, then V.
        // All heads' dim 0 first, then all heads' dim 1, etc.
        // src = token * (3*d) + dim_in_head * heads + head
        if (index >= count*d) return;
        uint token = index / d;
        uint dim_in_d = index % d;
        uint head = dim_in_d / head_dim;
        uint dim = dim_in_d % head_dim;
        uint src = token * qkv_stride + dim * heads + head;
        float q = load(pc.a+src), k = load(pc.a+src+d);
        // Apply RoPE to the first hd/4 dims paired with dims hd/2..hd/2+hd/4,
        // matching the CPU rotate() which loops i in 0..hd/4.
        uint rope_quarter = head_dim / 4u;
        if (pc.time != 0u && (dim < rope_quarter || (dim >= head_dim/2u && dim < head_dim/2u + rope_quarter))) {
            uint i = dim < rope_quarter ? dim : dim - head_dim/2u;
            uint other = dim < rope_quarter ? dim + rope_hd_half : dim - rope_hd_half;
            uint coeff = pc.e + (token % pc.seq) * rope_coeffs + i * 2u;
            float cos = load(coeff), sin = load(coeff+1u);
            float sign = dim < rope_hd_half ? -1.0 : 1.0;
            uint pair_src = token * qkv_stride + other * heads + head;
            q = q*cos + sign*load(pc.a+pair_src)*sin;
            k = k*cos + sign*load(pc.a+pair_src+d)*sin;
        }
        store(pc.b+index, q);
        store(pc.c+index, k);
        store(pc.d+index, load(pc.a+src+v_offset));
    } else if (pc.mode == 1u) {
        // Attention: one workgroup per query/head
        if (group >= count*heads) return;
        uint token = group / heads;
        uint head = group % heads;
        uint row = token / pc.seq;
        uint slot = token % pc.seq;
        uint keys = pc.time != 0u ? pc.seq : pc.rows;
        float query = load(pc.a + token*d + head*head_dim + lane);
        float value = 0.0;
        if (lane == 0u) { maximum = -1.0/0.0; denominator = 0.0; }
        barrier();
        for (uint j=0u; j<keys; j++) {
            if (!allowed(row,slot,j)) continue;
            uint key = pc.time != 0u ? row*pc.seq+j : j*pc.seq+slot;
            partial[lane] = query * load(pc.b + key*d + head*head_dim + lane);
            barrier();
            for (uint step=32u; step>0u; step>>=1u) {
                if (lane<step) partial[lane] += partial[lane+step];
                barrier();
            }
            if (lane == 0u) {
                float score = partial[0] / sqrt(float(head_dim));
                float next = max(maximum, score);
                alpha = exp_accurate(maximum-next);
                beta = exp_accurate(score-next);
                denominator = denominator*alpha + beta;
                maximum = next;
            }
            barrier();
            value = value*alpha + beta * load(pc.c + key*d + head*head_dim + lane);
            barrier();
        }
        store(pc.d + token*d + head*head_dim + lane, value/denominator);
    } else if (pc.mode == 2u) {
        // Gate: sigmoid(attn) * gate
        if (index >= count*d) return;
        store(pc.a+index, load(pc.a+index)/(1.0+exp_accurate(-load(pc.b+index))));
    } else {
        // SwiGlu: gate * up * sigmoid(up)
        uint ffn = pc.mlp_hidden_dim;
        if (index >= count*ffn) return;
        uint src = (index/ffn) * (2u*ffn) + index%ffn;
        float up = load(pc.a+src+ffn);
        store(pc.b+index, load(pc.a+src)*(up/(1.0+exp_accurate(-up))));
    }
}
