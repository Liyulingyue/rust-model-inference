#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint input_word;
    uint output_word;
    uint scales_word;
    uint count;
    uint input_stride;
    uint output_stride;
    uint scales_stride;
    uint token_rows;
    uint signed_scale;
} pc;

float value_at(uint index) {
    return uintBitsToFloat(arena.data[pc.input_word + gl_WorkGroupID.z * pc.input_stride + index]);
}

int nearest_int(float value) {
    return int((floatBitsToUint(value + 12582912.0) & 0x007fffffu) - 0x00400000u);
}

int round_away(float value) {
    float magnitude = abs(value);
    float integral = floor(magnitude);
    // Adding 0.5 first rounds the predecessor of 0.5 up to 1.0.
    return int(sign(value) * (integral + (magnitude - integral >= 0.5 ? 1.0 : 0.0)));
}

#include "f32_divide.glsl"

void main() {
    if (gl_LocalInvocationID.x != 0u) return;
    uint block = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint row = gl_WorkGroupID.z;
    uint base = block * 256u;
    if (base >= pc.count) return;
    float amax = 0.0;
    float max_value = 0.0;
    for (uint index = 0u; index < 256u; ++index) {
        float value = value_at(base + index);
        float absolute = abs(value);
        if (absolute > amax) {
            amax = absolute;
            max_value = value;
        }
    }
    if (amax == 0.0) {
        for (uint index = 0u; index < 64u; ++index) {
            arena.data[pc.output_word + row * pc.output_stride + block * 64u + index] = 0u;
        }
        arena.data[pc.scales_word + row * pc.scales_stride + block] = 0u;
        return;
    }
    precise float scale = pc.signed_scale != 0u
        ? 0.0 : divide_finite_normal(amax, 127.0);
    precise float iscale = pc.signed_scale != 0u
        ? divide_finite_normal(-127.0, max_value)
        : divide_finite_normal(1.0, scale);
    for (uint index = 0u; index < 64u; ++index) {
        uint packed = 0u;
        for (uint byte = 0u; byte < 4u; ++byte) {
            precise float scaled = iscale * value_at(base + index * 4u + byte);
            int quantized = pc.signed_scale != 0u
                ? clamp(nearest_int(scaled), -127, 127)
                : clamp(round_away(scaled), -127, 127);
            packed |= uint(quantized & 255) << (byte * 8u);
        }
        arena.data[pc.output_word + row * pc.output_stride + block * 64u + index] = packed;
    }
    if (pc.signed_scale != 0u) scale = divide_finite_normal(1.0, iscale);
    arena.data[pc.scales_word + row * pc.scales_stride + block] = floatBitsToUint(scale);
}
