#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC { uint q8_word; uint scales_word; uint n_in; uint blocks_per_row; uint output0_word; uint rows0; uint output1_word; uint rows1; uint output2_word; uint rows2; uint group_count; uint input_sum_word; } pc;
float f16_decode(uint bits) { uint sign = (bits >> 15u) & 1u; int exponent = int((bits >> 10u) & 0x1fu); uint mantissa = bits & 0x3ffu; float value = exponent == 0 ? float(mantissa) * exp2(-24.0) : (exponent == 31 ? 0.0 : (1.0 + float(mantissa) / 1024.0) * exp2(float(exponent - 15))); return sign == 0u ? value : -value; }
uint weight_word(uint slot, uint index) { return slot == 0u ? w0.data[index] : (slot == 1u ? w1.data[index] : w2.data[index]); }
uint weight_byte(uint slot, uint index) { return (weight_word(slot, index >> 2u) >> ((index & 3u) * 8u)) & 0xffu; }
int q8(uint index) { uint value = (arena.data[pc.q8_word + (index >> 2u)] >> ((index & 3u) * 8u)) & 0xffu; return value >= 128u ? int(value) - 256 : int(value); }
void main() { uint slot = gl_WorkGroupID.z; uint row = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x; uint rows = slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2); if (slot >= pc.group_count || row >= rows || gl_LocalInvocationID.x != 0u) return; precise float sum = 0.0; for (uint block = 0u; block < pc.blocks_per_row; ++block) { uint offset = row * pc.blocks_per_row * 20u + block * 20u; precise float d = f16_decode(weight_byte(slot, offset) | (weight_byte(slot, offset + 1u) << 8u)); precise float m = f16_decode(weight_byte(slot, offset + 2u) | (weight_byte(slot, offset + 3u) << 8u)); int dot = 0; for (uint l = 0u; l < 16u; ++l) { uint packed = weight_byte(slot, offset + 4u + l); int y0 = q8(block * 32u + l); int y1 = q8(block * 32u + 16u + l); dot += int(packed & 15u) * y0 + int(packed >> 4u) * y1; } precise float scale = uintBitsToFloat(arena.data[pc.scales_word + block]); precise float input_sum = uintBitsToFloat(arena.data[pc.input_sum_word + block]); precise float dot_term = (d * scale) * float(dot); precise float min_term = m * input_sum; sum += dot_term + min_term; } uint output_word = slot == 0u ? pc.output0_word : (slot == 1u ? pc.output1_word : pc.output2_word); arena.data[output_word + row] = floatBitsToUint(sum); }
