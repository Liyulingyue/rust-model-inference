#version 450

// SiLU activation for the PiVo convolution blocks.
//
// `out[i] = x / (1 + exp(-x))`
//
// The host path computes the same expression in F32. The device's
// exponential may differ from the host's by an ULP.

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;

layout(push_constant) uniform PC {
    uint buffer_word; uint count; uint stride;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.count) return;
    uint word = pc.buffer_word + index * pc.stride;
    float value = uintBitsToFloat(arena.data[word]);
    arena.data[word] = floatBitsToUint(value / (1.0 + exp(-value)));
}
