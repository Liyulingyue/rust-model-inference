#version 450
#extension GL_GOOGLE_include_directive : require
#include "f16_rounding.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint scores_word;
    uint heads;
    uint sequence_length;
    uint base_position;
    uint rows;
    /// Nonzero when every token is visible. A decoder hides tokens after the
    /// query; the Z-Image DiT has no mask, and folding that into `base_position`
    /// is not possible because the limit does not depend on the row.
    uint full_attention;
} pc;

shared float partial[64];
shared float partial_error[64];
shared float row_max;
shared float inverse_sum;

#include "exp_accurate.glsl"

void add_pair(
    inout float high,
    inout float low,
    float other_high,
    float other_low
) {
    precise float sum = high + other_high;
    precise float other_virtual = sum - high;
    precise float error =
        (high - (sum - other_virtual)) + (other_high - other_virtual);
    error += low + other_low;
    high = sum + error;
    low = error - (high - sum);
}

void main() {
    uint row = gl_WorkGroupID.z;
    if (row >= pc.rows) return;
    uint visible = pc.full_attention != 0u ? pc.sequence_length : pc.base_position + row + 1u;
    uint head = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (head >= pc.heads) return;
    uint lane = gl_LocalInvocationID.x;
    uint base = pc.scores_word + (row * pc.heads + head) * pc.sequence_length;
    float maximum = -1.0 / 0.0;
    for (uint index = lane; index < visible; index += 64u) {
        maximum = max(maximum, uintBitsToFloat(arena.data[base + index]));
    }
    partial[lane] = maximum;
    barrier();
    for (uint step = 32u; step > 0u; step >>= 1u) {
        if (lane < step) partial[lane] = max(partial[lane], partial[lane + step]);
        barrier();
    }
    if (lane == 0u) row_max = partial[0];
    barrier();

    float sum = 0.0;
    float sum_error = 0.0;
    for (uint index = lane; index < visible; index += 64u) {
        float value = exp_accurate(uintBitsToFloat(arena.data[base + index]) - row_max);
        arena.data[base + index] = floatBitsToUint(value);
        add_pair(sum, sum_error, value, 0.0);
    }
    partial[lane] = sum;
    partial_error[lane] = sum_error;
    barrier();
    for (uint step = 32u; step > 0u; step >>= 1u) {
        if (lane < step) {
            float high = partial[lane];
            float low = partial_error[lane];
            add_pair(high, low, partial[lane + step], partial_error[lane + step]);
            partial[lane] = high;
            partial_error[lane] = low;
        }
        barrier();
    }
    if (lane == 0u) {
        precise float inverse = 1.0 / partial[0];
        precise float residual = fma(-partial[0], inverse, 1.0);
        residual = fma(-partial_error[0], inverse, residual);
        inverse_sum = fma(residual, inverse, inverse);
    }
    barrier();
    for (uint index = lane; index < visible; index += 64u) {
        float value = uintBitsToFloat(arena.data[base + index]);
        value = round_f16_rte(value * inverse_sum);
        arena.data[base + index] = floatBitsToUint(value);
    }
}
