#version 450
#extension GL_GOOGLE_include_directive : require
#include "q4_0_accumulate.glsl"
#extension GL_EXT_spirv_intrinsics : require
spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6018, 6019], id = 4450)
int dotPacked4x8EXT(int a, int b, spirv_literal uint format);

// Register-tiled Q4_0 grouped matmul, one weight per (output column,
// k-block) reused across a tile of tokens.
//
// The kernel this replaces gives one workgroup per (token, output column)
// pair: every weight byte is loaded and unpacked again for a single
// token, so a multi-row forward reads the weights once per row, and the
// 32 products of a block are 32 scalar multiplies.
//
// Here a lane owns an output column for the whole k walk and keeps one
// accumulator per token in the tile. The block's 32 four-bit values are
// unpacked once and used for every token of the tile, and the products go
// through the packed dot product instead of scalar multiplies.
//
// The integer dot is exact; per-block accumulation uses the same selected
// CPU contract as the per-row kernel, including AVX2's FMA.
//
// The k walk is chunked rather than staged whole: a full row of q8
// activations is blocks_per_row * 8 words, which would be past the shared
// memory budget for a 32-token tile. CHUNK_BLOCKS keeps the staging area
// small enough that the loop stays in cache.

layout(local_size_x = 64) in;

const uint MAX_TOKENS = 32u;
const uint CHUNK_BLOCKS = 4u;
const uint INPUT_WORDS_PER_BLOCK = 8u;
// A Q4_0 block is a half-precision scale and 32 four-bit values: 18 bytes.
const uint BLOCK_BYTES = 18u;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC {
    uint q8_word;
    uint scales_word;
    uint n_in;
    uint blocks_per_row;
    uint output0_word; uint rows0; uint output0_stride;
    uint output1_word; uint rows1; uint output1_stride;
    uint output2_word; uint rows2; uint output2_stride;
    uint group_count; uint reduction_mode; uint input_stride; uint q8_stride; uint scales_stride; uint input_sum_stride; uint q8k_stride; uint q8k_scales_stride; uint token_rows;
} pc;

shared uint input_stage[MAX_TOKENS * CHUNK_BLOCKS * INPUT_WORDS_PER_BLOCK];
shared float scale_stage[MAX_TOKENS * CHUNK_BLOCKS];

float f16_decode(uint bits) {
    uint sign = (bits >> 15u) & 1u;
    int exponent = int((bits >> 10u) & 0x1Fu);
    uint man = (bits & 0x3FFu);
    float value;
    if (exponent == 0) {
        value = (float(man) / 1024.0) * exp2(-14.0);
    } else if (exponent == 31) {
        return 0.0;
    } else {
        value = (1.0 + (float(man) / 1024.0)) * exp2(float(exponent - 15));
    }
    return sign == 0u ? value : -value;
}

uint weight_word(uint slot, uint index) {
    if (slot == 0u) return w0.data[index];
    if (slot == 1u) return w1.data[index];
    return w2.data[index];
}

uint weight_byte(uint slot, uint index) {
    return (weight_word(slot, index >> 2u) >> ((index & 3u) * 8u)) & 0xffu;
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint slot = gl_WorkGroupID.z % pc.group_count;
    uint token_tile = gl_WorkGroupID.z / pc.group_count;
    uint token_base = token_tile * MAX_TOKENS;
    if (token_base >= pc.token_rows) return;

    // One lane, one output column, for the whole k walk. The workgroup
    // covers 64 consecutive columns, so the tile is 64 wide rather than 1.
    uint column_base = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 64u;
    uint column = column_base + lane;
    uint output_stride = slot == 0u ? pc.output0_stride : (slot == 1u ? pc.output1_stride : pc.output2_stride);
    uint output_word = slot == 0u ? pc.output0_word : (slot == 1u ? pc.output1_word : pc.output2_word);
    uint output_rows = slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2);
    // A partial last tile would put some lanes past the end of the weight
    // buffer. They cannot return, because the loop below has barriers and
    // Vulkan requires those in uniform control flow, so clamp their read to a
    // column that exists and let the store drop the result.
    uint read_column = min(column, output_rows - 1u);

    precise float accumulator[MAX_TOKENS];
    for (uint t = 0u; t < MAX_TOKENS; t++) {
        accumulator[t] = 0.0;
    }
    uint live = 0u;
    for (uint t = 0u; t < MAX_TOKENS; t++) {
        if (token_base + t < pc.token_rows) live = t + 1u;
    }
    if (live == 0u) return;

    uint weight_row = read_column * pc.blocks_per_row * BLOCK_BYTES;

    for (uint chunk = 0u; chunk < pc.blocks_per_row; chunk += CHUNK_BLOCKS) {
        uint blocks = min(CHUNK_BLOCKS, pc.blocks_per_row - chunk);
        // Stage this chunk's q8 activations for every live token.
        uint words = blocks * INPUT_WORDS_PER_BLOCK;
        for (uint t = 0u; t < live; t++) {
            uint base = (token_base + t) * pc.q8_stride + chunk * INPUT_WORDS_PER_BLOCK;
            uint dst = t * CHUNK_BLOCKS * INPUT_WORDS_PER_BLOCK;
            for (uint index = lane; index < words; index += 64u) {
                input_stage[dst + index] = arena.data[pc.q8_word + base + index];
            }
        }
        for (uint t = 0u; t < live; t++) {
            uint base = (token_base + t) * pc.scales_stride + chunk;
            uint dst = t * CHUNK_BLOCKS;
            for (uint index = lane; index < blocks; index += 64u) {
                scale_stage[dst + index] = uintBitsToFloat(arena.data[pc.scales_word + base + index]);
            }
        }
        barrier();

        for (uint b = 0u; b < blocks; b++) {
            uint block = chunk + b;
            uint byte_offset = weight_row + block * BLOCK_BYTES;
            uint scale_word = weight_word(slot, byte_offset >> 2u);
            uint scale_bits = (byte_offset & 3u) == 0u
                ? scale_word & 0xffffu
                : (scale_word >> 16u) & 0xffffu;
            float weight_scale = f16_decode(scale_bits);
            uint body = byte_offset + 2u;
            // The 32 four-bit values of this block, in element order, packed
            // four to a word. A Q4_0 block keeps its first 16 values in the
            // low nibbles of its 16 bytes and the next 16 in the high
            // nibbles of the same bytes, so the block's 16 bytes give two
            // groups of four words: the low half and the high half.
            uint low_words[4];
            uint high_words[4];
            for (uint g = 0u; g < 4u; g++) {
                uint base = body + 4u * g;
                uint byte0 = weight_byte(slot, base);
                uint byte1 = weight_byte(slot, base + 1u);
                uint byte2 = weight_byte(slot, base + 2u);
                uint byte3 = weight_byte(slot, base + 3u);
                int low0 = int(byte0 & 15u) - 8;
                int low1 = int(byte1 & 15u) - 8;
                int low2 = int(byte2 & 15u) - 8;
                int low3 = int(byte3 & 15u) - 8;
                int high0 = int(byte0 >> 4u) - 8;
                int high1 = int(byte1 >> 4u) - 8;
                int high2 = int(byte2 >> 4u) - 8;
                int high3 = int(byte3 >> 4u) - 8;
                low_words[g] = uint(low0 & 0xff) | (uint(low1 & 0xff) << 8u)
                    | (uint(low2 & 0xff) << 16u) | (uint(low3 & 0xff) << 24u);
                high_words[g] = uint(high0 & 0xff) | (uint(high1 & 0xff) << 8u)
                    | (uint(high2 & 0xff) << 16u) | (uint(high3 & 0xff) << 24u);
            }
            // One weight load, TOKENS dots.
            for (uint t = 0u; t < live; t++) {
                uint base = t * CHUNK_BLOCKS * INPUT_WORDS_PER_BLOCK + b * INPUT_WORDS_PER_BLOCK;
                int partial = 0;
                for (uint g = 0u; g < 8u; g++) {
                    uint word = g < 4u ? low_words[g] : high_words[g - 4u];
                    partial += dotPacked4x8EXT(int(word), int(input_stage[base + g]), 0u);
                }
                accumulator[t] = q4_0_accumulate(accumulator[t], partial,
                    weight_scale, scale_stage[t * CHUNK_BLOCKS + b], pc.reduction_mode);
            }
        }
        barrier();
    }

    if (column < output_rows) {
        for (uint t = 0u; t < live; t++) {
            arena.data[output_word + (token_base + t) * output_stride + column] =
                floatBitsToUint(accumulator[t]);
        }
    }
}
