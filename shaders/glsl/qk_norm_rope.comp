#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer QNorm { uint data[]; } q_norm;
layout(std430, binding = 2) readonly buffer KNorm { uint data[]; } k_norm;
layout(push_constant) uniform PC {
    uint q_word;
    uint k_word;
    uint q_norm_word;
    uint k_norm_word;
    uint q_heads;
    uint k_heads;
    uint head_dim;
    uint position;
    uint norm_flags;
    float eps;
    float freq_base;
} pc;

shared float partial[64];
shared float inverse_rms;

float norm_weight(uint kind, uint index) {
    return kind == 0u
        ? uintBitsToFloat(q_norm.data[pc.q_norm_word + index])
        : uintBitsToFloat(k_norm.data[pc.k_norm_word + index]);
}

void main() {
    uint kind = gl_WorkGroupID.y;
    uint head = gl_WorkGroupID.x;
    uint heads = kind == 0u ? pc.q_heads : pc.k_heads;
    if (kind > 1u || head >= heads) return;
    uint lane = gl_LocalInvocationID.x;
    uint base = (kind == 0u ? pc.q_word : pc.k_word) + head * pc.head_dim;
    bool normalize = (pc.norm_flags & (1u << kind)) != 0u;

    if (normalize) {
        float sum = 0.0;
        for (uint index = lane; index < pc.head_dim; index += 64u) {
            float value = uintBitsToFloat(arena.data[base + index]);
            sum = fma(value, value, sum);
        }
        partial[lane] = sum;
        barrier();
        for (uint step = 32u; step > 0u; step >>= 1u) {
            if (lane < step) partial[lane] += partial[lane + step];
            barrier();
        }
        if (lane == 0u) inverse_rms = inversesqrt(partial[0] / float(pc.head_dim) + pc.eps);
        barrier();
        for (uint index = lane; index < pc.head_dim; index += 64u) {
            float value = uintBitsToFloat(arena.data[base + index]);
            arena.data[base + index] = floatBitsToUint(value * inverse_rms * norm_weight(kind, index));
        }
        barrier();
    }

    uint half_dim = pc.head_dim / 2u;
    if (lane < half_dim) {
        float theta_scale = pow(pc.freq_base, -2.0 / float(pc.head_dim));
        float theta = float(pc.position);
        for (uint index = 0u; index < lane; index++) theta *= theta_scale;
        float cosine = cos(theta);
        float sine = sin(theta);
        float first = uintBitsToFloat(arena.data[base + lane]);
        float second = uintBitsToFloat(arena.data[base + lane + half_dim]);
        arena.data[base + lane] = floatBitsToUint(fma(first, cosine, -second * sine));
        arena.data[base + lane + half_dim] = floatBitsToUint(fma(first, sine, second * cosine));
    }
}
