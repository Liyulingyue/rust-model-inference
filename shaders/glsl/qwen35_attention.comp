#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint q_word;
    uint gate_word;
    uint cache_k_word;
    uint cache_v_word;
    uint output_word;
    uint layer;
    uint base_position;
    uint capacity;
    uint q_heads;
    uint kv_heads;
    uint head_dim;
    // Reduction width the host pads the score/value buffers to (a multiple of
    // 256). The CPU trunk reduces over `n_attend.div_ceil(256) * 256` elements
    // with the tail zero-filled, so matching that width here keeps the SIMD
    // reduction order identical and the prompt logits stable as the sequence
    // grows.
    uint padded_length;
} pc;

shared float scores[4096];
shared float lane_max[64];
shared float lane_sum[64];

void main() {
    uint head = gl_WorkGroupID.x;
    uint row = gl_WorkGroupID.y;
    uint sequence_length = pc.base_position + row + 1u;
    if (head >= pc.q_heads) return;
    uint lane = gl_LocalInvocationID.x;
    uint kv_head = head / (pc.q_heads / pc.kv_heads);
    uint kv_count = pc.kv_heads * pc.head_dim;
    uint q_base = pc.q_word + (row * pc.q_heads + head) * pc.head_dim;
    uint padded = pc.padded_length;
    float scale = inversesqrt(float(pc.head_dim));

    // Scores are computed across the 64 invocations: each lane takes a slice of
    // the tokens, so the 64-wide workgroup is doing work instead of leaving
    // lane 0 to serialise the whole attention row.
    for (uint token = lane; token < padded; token += 64u) {
        if (token < sequence_length) {
            uint k_base = pc.cache_k_word
                + (pc.layer * pc.capacity + token) * kv_count
                + kv_head * pc.head_dim;
            // Match `dot_f32_avx2`: eight independent accumulators then a
            // horizontal sum. A single accumulator drifts enough over 100+
            // tokens to reorder the top logits.
            precise float dot[8];
            for (uint l = 0u; l < 8u; l++) dot[l] = 0.0;
            uint index = 0u;
            for (; index + 8u <= pc.head_dim; index += 8u) {
                for (uint l = 0u; l < 8u; l++) {
                    dot[l] = fma(
                        uintBitsToFloat(arena.data[q_base + index + l]),
                        uintBitsToFloat(arena.data[k_base + index + l]),
                        dot[l]
                    );
                }
            }
            precise float total = (dot[0] + dot[1]) + (dot[2] + dot[3])
                + (dot[4] + dot[5]) + (dot[6] + dot[7]);
            for (; index < pc.head_dim; index++) {
                total = fma(
                    uintBitsToFloat(arena.data[q_base + index]),
                    uintBitsToFloat(arena.data[k_base + index]),
                    total
                );
            }
            scores[token] = total * scale;
        } else {
            // Match the CPU trunk's `f32::NEG_INFINITY` tail: it keeps the
            // softmax reduction width fixed without contributing weight.
            scores[token] = -3.402823466e+38;
        }
    }
    barrier();

    // Softmax over the padded width. The maximum and the normaliser are each
    // reduced across the lanes so no single invocation walks the whole row.
    precise float local_max = -3.402823466e+38;
    for (uint token = lane; token < padded; token += 64u) {
        local_max = max(local_max, scores[token]);
    }
    lane_max[lane] = local_max;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) lane_max[lane] = max(lane_max[lane], lane_max[lane + stride]);
        barrier();
    }
    float maximum = lane_max[0];
    barrier();

    precise float local_sum = 0.0;
    for (uint token = lane; token < padded; token += 64u) {
        float value = exp(scores[token] - maximum);
        scores[token] = value;
        local_sum += value;
    }
    lane_sum[lane] = local_sum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) lane_sum[lane] += lane_sum[lane + stride];
        barrier();
    }
    float inverse_sum = 1.0 / lane_sum[0];
    barrier();

    for (uint token = lane; token < padded; token += 64u) {
        scores[token] *= inverse_sum;
    }
    barrier();

    // Mirror `dot_f32_avx2`: eight independent lanes, a horizontal sum, then
    // the scalar tail. Reducing sequentially instead makes the accumulated
    // error grow with the sequence length and shifts the prompt logits.
    for (uint index = lane; index < pc.head_dim; index += 64u) {
        precise float acc[8];
        for (uint l = 0u; l < 8u; l++) acc[l] = 0.0;
        uint token = 0u;
        for (; token + 8u <= padded; token += 8u) {
            for (uint l = 0u; l < 8u; l++) {
                if (token + l < sequence_length) {
                    uint v_index = pc.cache_v_word
                        + (pc.layer * pc.capacity + token + l) * kv_count
                        + kv_head * pc.head_dim + index;
                    acc[l] = fma(
                        scores[token + l],
                        uintBitsToFloat(arena.data[v_index]),
                        acc[l]
                    );
                }
            }
        }
        precise float value = (acc[0] + acc[1]) + (acc[2] + acc[3])
            + (acc[4] + acc[5]) + (acc[6] + acc[7]);
        for (; token < padded; token++) {
            if (token < sequence_length) {
                uint v_index = pc.cache_v_word
                    + (pc.layer * pc.capacity + token) * kv_count
                    + kv_head * pc.head_dim + index;
                value = fma(scores[token], uintBitsToFloat(arena.data[v_index]), value);
            }
        }
        float gate = uintBitsToFloat(
            arena.data[pc.gate_word + (row * pc.q_heads + head) * pc.head_dim + index]
        );
        value *= 1.0 / (1.0 + exp(-gate));
        arena.data[pc.output_word + (row * pc.q_heads + head) * pc.head_dim + index] = floatBitsToUint(value);
    }
}
