#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint gate_word;
    uint up_word;
    uint count;
    uint rows;
    uint row_stride;
    uint output_word;
    uint exp_mode;
} pc;

#include "silu_exp.glsl"
#include "f32_divide.glsl"

void main() {
    uint row = gl_WorkGroupID.z;
    if (row >= pc.rows) return;
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint index = group * 64u + gl_LocalInvocationID.x;
    if (index >= pc.count) return;
    index += row * pc.row_stride;
    float gate = uintBitsToFloat(arena.data[pc.gate_word + index]);
    float up = uintBitsToFloat(arena.data[pc.up_word + index]);
    uint column = index - row * pc.row_stride;
    float exponential = silu_exponential(0.0 - gate, pc.exp_mode, column, pc.count);
    precise float denominator = 1.0 + exponential;
    precise float activated = divide_finite_normal(gate, denominator);
    precise float product = activated * up;
    uint bits = product == 0.0
        ? (floatBitsToUint(gate) ^ floatBitsToUint(up)) & 0x80000000u
        : floatBitsToUint(product);
    arena.data[pc.output_word + index] = bits;
}
