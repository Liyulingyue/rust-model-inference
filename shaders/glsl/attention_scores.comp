#version 450
#extension GL_GOOGLE_include_directive : require
#include "f16_rounding.glsl"
#include "f16_dot.glsl"
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(push_constant) uniform PC {
    uint q_word;
    uint cache_k_word;
    uint scores_word;
    uint layer;
    uint sequence_length;
    uint capacity;
    uint q_heads;
    uint kv_heads;
    uint head_dim;
    float scale;
    uint base_position;
    uint rows;
    uint full_attention;
    uint reduction_mode;
} pc;

void add_pair(inout float high, inout float low, float value) {
    precise float sum = high + value;
    precise float value_virtual = sum - high;
    precise float error = (high - (sum - value_virtual)) + (value - value_virtual) + low;
    high = sum + error;
    low = error - (high - sum);
}

void main() {
    uint row = gl_WorkGroupID.z;
    if (row >= pc.rows) return;
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint index = group * 64u + gl_LocalInvocationID.x;
    uint total = pc.q_heads * pc.sequence_length;
    if (index >= total) return;
    uint head = index / pc.sequence_length;
    uint token = index - head * pc.sequence_length;
    if (token >= pc.base_position + row + 1u) return;
    uint kv_head = head / (pc.q_heads / pc.kv_heads);
    uint q_base = pc.q_word + (row * pc.q_heads + head) * pc.head_dim;
    uint key_base = pc.cache_k_word
        + (pc.layer * pc.capacity + token) * (pc.kv_heads * pc.head_dim)
        + kv_head * pc.head_dim;
    precise float sum = 0.0;
    precise float correction = 0.0;
    precise float accumulators[32];
    for (uint i = 0u; i < 32u; i++) accumulators[i] = 0.0;
    bool online = (pc.reduction_mode & 256u) != 0u;
    uint mode = pc.reduction_mode & 255u;
    uint width = mode == 1u ? 32u : mode == 4u ? 4u : 8u;
    uint prefix = mode == 0u ? 0u : pc.head_dim / width * width;
    for (uint dimension = 0u; dimension < pc.head_dim; dimension++) {
        float query = uintBitsToFloat(arena.data[q_base + dimension]);
        if (!online) query = round_f16_rte(query);
        float key = round_f16_rte(uintBitsToFloat(arena.data[key_base + dimension]));
        precise float product = query * key;
        if (dimension < prefix) {
            uint lane = dimension % width;
            accumulators[lane] = mode == 1u
                ? half_fma(query, key, accumulators[lane])
                : fma(query, key, accumulators[lane]);
            if (dimension + 1u == prefix) {
                sum = mode == 1u ? reduce_half32(accumulators)
                    : mode == 4u ? (accumulators[0] + accumulators[1]) + (accumulators[2] + accumulators[3])
                    : reduce_float8(accumulators);
            }
        } else {
            if (online) sum += product;
            else add_pair(sum, correction, product);
        }
    }
    arena.data[pc.scores_word + row * total + index] = floatBitsToUint((sum + correction) * pc.scale);
}
