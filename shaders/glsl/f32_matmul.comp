#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC {
    uint input_word;
    uint wide_sum;
    uint n_in;
    uint elements_per_row;
    uint output0_word; uint rows0; uint output0_stride;
    uint output1_word; uint rows1; uint output1_stride;
    uint output2_word; uint rows2; uint output2_stride;
    uint group_count; uint input_sum_word; uint input_stride; uint q8_stride; uint scales_stride; uint input_sum_stride; uint q8k_stride; uint q8k_scales_stride; uint token_rows;
    uint expert_count; uint expert_ids_word; uint expert_used; uint expert_slot;
} pc;

shared float partial[64];

uint weight_word(uint slot, uint index) {
    if (slot == 0u) return w0.data[index];
    if (slot == 1u) return w1.data[index];
    return w2.data[index];
}

void main() {
    uint token_row = gl_WorkGroupID.z / pc.group_count; uint slot = gl_WorkGroupID.z % pc.group_count;
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint invocation = gl_LocalInvocationID.x;
    uint rows = slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2);
    if (slot >= pc.group_count) return;

    // AVX2 uses two independent eight-lane FMA streams, then two horizontal sums.
    uint lanes = pc.wide_sum == 16u ? 16u : 1u;
    uint row = group * (64u / lanes) + invocation / lanes;
    uint lane = invocation % lanes;
    uint row_base = row * pc.elements_per_row;
    if (pc.expert_count != 0u) {
        uint expert = arena.data[pc.expert_ids_word + token_row * pc.expert_used + pc.expert_slot];
        row_base += min(expert, pc.expert_count - 1u) * rows * pc.elements_per_row;
    }
    uint output_word = slot == 0u
        ? pc.output0_word
        : (slot == 1u ? pc.output1_word : pc.output2_word);
    uint output_stride = slot == 0u ? pc.output0_stride : (slot == 1u ? pc.output1_stride : pc.output2_stride);
    if (lanes == 16u) {
        precise float acc = 0.0;
        if (row < rows) {
            for (uint index = lane; index < pc.n_in / 16u * 16u; index += 16u) {
                float x = uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]);
                acc = fma(uintBitsToFloat(weight_word(slot, row_base + index)), x, acc);
            }
            if (pc.n_in % 16u != 0u && lane < 8u) {
                uint index = pc.n_in / 16u * 16u + lane;
                float x = uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]);
                acc = fma(uintBitsToFloat(weight_word(slot, row_base + index)), x, acc);
            }
        }
        partial[invocation] = acc;
        barrier();
        if (lane != 0u || row >= rows) return;
        precise float low = ((partial[invocation] + partial[invocation + 4u])
            + (partial[invocation + 1u] + partial[invocation + 5u]))
            + ((partial[invocation + 2u] + partial[invocation + 6u])
            + (partial[invocation + 3u] + partial[invocation + 7u]));
        precise float high = ((partial[invocation + 8u] + partial[invocation + 12u])
            + (partial[invocation + 9u] + partial[invocation + 13u]))
            + ((partial[invocation + 10u] + partial[invocation + 14u])
            + (partial[invocation + 11u] + partial[invocation + 15u]));
        arena.data[output_word + token_row * output_stride + row] = floatBitsToUint(low + high);
        return;
    }
    if (row >= rows) return;

    precise float sum = 0.0;
    precise float correction = 0.0;
    for (uint index = 0u; index < pc.n_in; index++) {
        float input_value = uintBitsToFloat(arena.data[pc.input_word + token_row * pc.input_stride + index]);
        float weight_value = uintBitsToFloat(weight_word(slot, row_base + index));
        precise float term = weight_value * input_value;
        precise float next = sum + term;
        if (pc.wide_sum != 0u) {
            correction += abs(sum) >= abs(term)
                ? (sum - next) + term : (term - next) + sum;
        }
        sum = next;
    }

    arena.data[output_word + token_row * output_stride + row] = floatBitsToUint(sum + correction);
}
