#version 450

layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC { uint q8_word; uint scales_word; uint n_in; uint blocks_per_row; uint output0_word; uint rows0; uint output0_stride; uint output1_word; uint rows1; uint output1_stride; uint output2_word; uint rows2; uint output2_stride; uint group_count; uint input_sum_word; uint input_stride; uint q8_stride; uint scales_stride; uint input_sum_stride; uint q8k_stride; uint q8k_scales_stride; uint token_rows; } pc;

float f16_decode(uint bits) { uint sign = (bits >> 15u) & 1u; int exponent = int((bits >> 10u) & 0x1fu); uint mantissa = bits & 0x3ffu; float value = exponent == 0 ? float(mantissa) * exp2(-24.0) : (exponent == 31 ? 0.0 : (1.0 + float(mantissa) / 1024.0) * exp2(float(exponent - 15))); return sign == 0u ? value : -value; }
uint weight_word(uint slot, uint index) { return slot == 0u ? w0.data[index] : (slot == 1u ? w1.data[index] : w2.data[index]); }
uint weight_byte(uint slot, uint index) { return (weight_word(slot, index >> 2u) >> ((index & 3u) * 8u)) & 0xffu; }
int weight_i8(uint slot, uint index) { uint value = weight_byte(slot, index); return value >= 128u ? int(value) - 256 : int(value); }
int q8(uint index) { uint value = (arena.data[pc.q8_word + (gl_WorkGroupID.z / pc.group_count) * pc.q8_stride + (index >> 2u)] >> ((index & 3u) * 8u)) & 0xffu; return value >= 128u ? int(value) - 256 : int(value); }
int weight_scale(uint slot, uint offset, uint local) {
    uint section = local / 128u;
    uint quarter = (local % 128u) / 32u;
    return weight_i8(slot, offset + 192u + section * 8u + (local % 32u) / 16u + quarter * 2u);
}

int weight_code(uint slot, uint offset, uint local) {
    uint section = local / 128u;
    uint quarter = (local % 128u) / 32u;
    uint l = local % 32u;
    uint ql = section * 64u + l + (quarter == 1u || quarter == 3u ? 32u : 0u);
    uint qh = section * 32u + l;
    uint low = quarter < 2u ? weight_byte(slot, offset + ql) & 15u : weight_byte(slot, offset + ql) >> 4u;
    uint high = (weight_byte(slot, offset + 128u + qh) >> (quarter * 2u)) & 3u;
    return int(low | (high << 4u));
}

shared float partial_sums[64];

void main() {
    uint token_row = gl_WorkGroupID.z / pc.group_count;
    uint slot = gl_WorkGroupID.z % pc.group_count;
    uint invocation = gl_LocalInvocationID.x;
    uint lane = invocation % 8u;
    uint row = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 8u + invocation / 8u;
    uint rows = slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2);
    precise float sum = 0.0;
    if (slot < pc.group_count && row < rows) {
        for (uint block = 0u; block < pc.blocks_per_row; ++block) {
            uint offset = (row * pc.blocks_per_row + block) * 210u;
            precise float scale = f16_decode(weight_byte(slot, offset + 208u) | (weight_byte(slot, offset + 209u) << 8u))
                * uintBitsToFloat(arena.data[pc.scales_word + token_row * pc.scales_stride + block]);
            int dot = 0;
            if (pc.input_sum_word != 0u) {
                for (uint i = 0u; i < 32u; i++) {
                    uint local = lane + i * 8u;
                    dot += weight_scale(slot, offset, local) * q8(block * 256u + local)
                        * (weight_code(slot, offset, local) - 32);
                }
                precise float term = scale * float(dot);
                sum += term;
                continue;
            }
            for (uint group = 0u; group < 8u; group++) {
                for (uint i = 0u; i < 4u; i++) {
                    uint local = group * 32u + lane * 4u + i;
                    dot += weight_scale(slot, offset, local) * q8(block * 256u + local)
                        * weight_code(slot, offset, local);
                }
            }
            int correction = 0;
            for (uint i = 0u; i < 32u; i++) {
                uint local = lane * 32u + i;
                correction += weight_scale(slot, offset, local) * q8(block * 256u + local);
            }
            dot -= correction << 5;
            sum = fma(scale, float(dot), sum);
        }
    }
    partial_sums[invocation] = sum;
    barrier();
    if (lane != 0u || slot >= pc.group_count || row >= rows) return;
    precise float result = 0.0;
    if (pc.input_sum_word != 0u) {
        for (uint i = 0u; i < 8u; i++) result += partial_sums[invocation + i];
    } else {
        result = ((partial_sums[invocation] + partial_sums[invocation + 4u])
        + (partial_sums[invocation + 1u] + partial_sums[invocation + 5u]))
        + ((partial_sums[invocation + 2u] + partial_sums[invocation + 6u])
        + (partial_sums[invocation + 3u] + partial_sums[invocation + 7u]));
    }
    uint output_word = slot == 0u ? pc.output0_word : (slot == 1u ? pc.output1_word : pc.output2_word);
    uint output_stride = slot == 0u ? pc.output0_stride : (slot == 1u ? pc.output1_stride : pc.output2_stride);
    arena.data[output_word + token_row * output_stride + row] = floatBitsToUint(result);
}
