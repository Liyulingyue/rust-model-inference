#version 450

layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Arena { uint data[]; } arena;
layout(std430, binding = 1) readonly buffer W0 { uint data[]; } w0;
layout(std430, binding = 2) readonly buffer W1 { uint data[]; } w1;
layout(std430, binding = 3) readonly buffer W2 { uint data[]; } w2;
layout(push_constant) uniform PC { uint q8_word; uint scales_word; uint n_in; uint blocks_per_row; uint output0_word; uint rows0; uint output0_stride; uint output1_word; uint rows1; uint output1_stride; uint output2_word; uint rows2; uint output2_stride; uint group_count; uint input_sum_word; uint input_stride; uint q8_stride; uint scales_stride; uint input_sum_stride; uint q8k_stride; uint q8k_scales_stride; uint token_rows; } pc;

float f16_decode(uint bits) { uint sign = (bits >> 15u) & 1u; int exponent = int((bits >> 10u) & 0x1fu); uint mantissa = bits & 0x3ffu; float value = exponent == 0 ? float(mantissa) * exp2(-24.0) : (exponent == 31 ? 0.0 : (1.0 + float(mantissa) / 1024.0) * exp2(float(exponent - 15))); return sign == 0u ? value : -value; }
uint weight_word(uint slot, uint index) { return slot == 0u ? w0.data[index] : (slot == 1u ? w1.data[index] : w2.data[index]); }
int weight_i8_word(uint slot, uint index) {
    // Read byte at `index` via u32 word access + shift/mask.
    uint word = weight_word(slot, index >> 2u);
    uint value = (word >> ((index & 3u) * 8u)) & 0xffu;
    return value >= 128u ? int(value) - 256 : int(value);
}
int i8(uint value) { return value >= 128u ? int(value) - 256 : int(value); }

// Q6_K block layout (210 bytes):
//   [0..127]:  ql: low nibbles. Element local = 128s + 32q + t (s = section,
//              q = quarter, t = position) reads ql byte 64s + t + (q odd ? 32 : 0),
//              low nibble for q < 2, high nibble otherwise.
//   [128..191]: qh: 2-bit high fields. Byte 32s + t holds quarter q's 2 bits of
//              position t (all four quarters per byte).
//   [192..207]: 16 signed per-16-element scales: scale of element `local` is
//              byte 192 + local/16.
//   [208..209]: block scale (f16).
//
// Lane L owns positions 4L..4L+3 of every 32-element group, so its sixteen
// elements per block read six 4-byte runs: ql bytes 4L..4L+3 / 32+4L..+4 of
// each section (each run serves the two quarters that share its nibbles) and
// the matching qh runs. Every run sits at a 4-aligned block-relative offset,
// so one u32 window fetches it -- the 210-byte blocks start at 2 mod 4 every
// other block, hence the two-word window below. The window's second word is
// only loaded when the block is actually misaligned, so the last block of
// the tensor never reads past the buffer's final word.

uint block_window(uint slot, uint w, uint shift) {
    uint a = weight_word(slot, w);
    if (shift == 0u) return a;
    return (a >> 16u) | (weight_word(slot, w + 1u) << 16u);
}

shared float partial_sums[64];
shared int input_q8[256];

// Scalar (non-AVX2) fallback keeps the byte-granular helpers.

int weight_scale_u32(uint slot, uint offset, uint local) {
    uint section = local / 128u;
    uint quarter = (local % 128u) / 32u;
    uint byte_index = offset + 192u + section * 8u + (local % 32u) / 16u + quarter * 2u;
    return weight_i8_word(slot, byte_index);
}

int weight_code_u32(uint slot, uint offset, uint local) {
    uint section = local / 128u;
    uint quarter = (local % 128u) / 32u;
    uint l = local % 32u;
    uint ql = section * 64u + l + (quarter == 1u || quarter == 3u ? 32u : 0u);
    uint qh = section * 32u + l;
    uint lo_word = weight_word(slot, (offset + ql) >> 2u);
    uint lo_byte = (lo_word >> (((offset + ql) & 3u) * 8u)) & 0xffu;
    uint low = quarter < 2u ? lo_byte & 15u : lo_byte >> 4u;
    uint hi_word = weight_word(slot, (offset + 128u + qh) >> 2u);
    uint hi_byte = (hi_word >> (((offset + 128u + qh) & 3u) * 8u)) & 0xffu;
    uint high = (hi_byte >> (quarter * 2u)) & 3u;
    return int(low | (high << 4u));
}

void main() {
    uint token_row = gl_WorkGroupID.z / pc.group_count;
    uint slot = gl_WorkGroupID.z % pc.group_count;
    uint invocation = gl_LocalInvocationID.x;
    uint lane = invocation % 8u;
    uint row = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 8u + invocation / 8u;
    uint rows = slot == 0u ? pc.rows0 : (slot == 1u ? pc.rows1 : pc.rows2);
    bool valid_row = slot < pc.group_count && row < rows;
    precise float sum = 0.0;
    for (uint block = 0u; block < pc.blocks_per_row; ++block) {
        // Stage the block's 256 q8 bytes: one arena word per invocation
        // covers four consecutive elements.
        {
            uint stage = arena.data[pc.q8_word + token_row * pc.q8_stride + block * 64u + invocation];
            for (uint k = 0u; k < 4u; ++k) {
                uint v = (stage >> (8u * k)) & 0xffu;
                input_q8[4u * invocation + k] = v >= 128u ? int(v) - 256 : int(v);
            }
        }
        barrier();
        if (valid_row) {
            uint offset = (row * pc.blocks_per_row + block) * 210u;
            // Read block scale (f16 at bytes 208-209): the pair never
            // straddles a word boundary (208 is 0 mod 4).
            uint scale_word = weight_word(slot, (offset + 208u) >> 2u);
            uint scale_byte0 = (scale_word >> (((offset + 208u) & 3u) * 8u)) & 0xffu;
            uint scale_byte1 = (scale_word >> (((offset + 209u) & 3u) * 8u)) & 0xffu;
            precise float scale = f16_decode(scale_byte0 | (scale_byte1 << 8u))
                * uintBitsToFloat(arena.data[pc.scales_word + token_row * pc.scales_stride + block]);
            int dot = 0;
            if (pc.input_sum_word != 0u) {
                for (uint i = 0u; i < 32u; i++) {
                    uint local = lane + i * 8u;
                    dot += weight_scale_u32(slot, offset, local)
                        * input_q8[local]
                        * (weight_code_u32(slot, offset, local) - 32);
                }
                precise float term = scale * float(dot);
                sum += term;
            } else {
                uint wbase = offset >> 2u;
                uint shift = (offset & 2u) * 8u;
                // The sixteen signed scales, four windows for bytes 192..207.
                int sc[16];
                {
                    uint wa = block_window(slot, wbase + 48u, shift);
                    uint wb = block_window(slot, wbase + 49u, shift);
                    uint wc = block_window(slot, wbase + 50u, shift);
                    uint wd = block_window(slot, wbase + 51u, shift);
                    sc[0] = i8(wa & 0xffu); sc[1] = i8((wa >> 8u) & 0xffu);
                    sc[2] = i8((wa >> 16u) & 0xffu); sc[3] = i8((wa >> 24u) & 0xffu);
                    sc[4] = i8(wb & 0xffu); sc[5] = i8((wb >> 8u) & 0xffu);
                    sc[6] = i8((wb >> 16u) & 0xffu); sc[7] = i8((wb >> 24u) & 0xffu);
                    sc[8] = i8(wc & 0xffu); sc[9] = i8((wc >> 8u) & 0xffu);
                    sc[10] = i8((wc >> 16u) & 0xffu); sc[11] = i8((wc >> 24u) & 0xffu);
                    sc[12] = i8(wd & 0xffu); sc[13] = i8((wd >> 8u) & 0xffu);
                    sc[14] = i8((wd >> 16u) & 0xffu); sc[15] = i8((wd >> 24u) & 0xffu);
                }
                // Lane's six 4-byte runs: ql nibble pairs of both sections
                // and the qh rows holding this lane's positions in each
                // section. Eight lanes read eight consecutive words per run.
                uint run_ql_e0 = block_window(slot, wbase + lane, shift);
                uint run_ql_o0 = block_window(slot, wbase + 8u + lane, shift);
                uint run_ql_e1 = block_window(slot, wbase + 16u + lane, shift);
                uint run_ql_o1 = block_window(slot, wbase + 24u + lane, shift);
                uint run_qh_0 = block_window(slot, wbase + 32u + lane, shift);
                uint run_qh_1 = block_window(slot, wbase + 40u + lane, shift);
                for (uint g = 0u; g < 8u; ++g) {
                    int gsc = sc[2u * g + (lane >> 2u)];
                    uint run = (g & 4u) == 0u
                        ? ((g & 1u) == 0u ? run_ql_e0 : run_ql_o0)
                        : ((g & 1u) == 0u ? run_ql_e1 : run_ql_o1);
                    uint qh = (g & 4u) == 0u ? run_qh_0 : run_qh_1;
                    uint qh_shift = 2u * (g & 3u);
                    bool low_nibble = (g & 3u) < 2u;
                    for (uint i = 0u; i < 4u; ++i) {
                        uint low = low_nibble
                            ? (run >> (8u * i)) & 15u
                            : (run >> (8u * i + 4u)) & 15u;
                        uint high = (qh >> (8u * i + qh_shift)) & 3u;
                        dot += gsc * input_q8[32u * g + 4u * lane + i]
                            * int(low | (high << 4u));
                    }
                }
                // The AVX2 reference distributes the -32 correction by lane
                // index rather than by element ownership: lane L subtracts
                // 32 * (sc[2L]*bsum[2L] + sc[2L+1]*bsum[2L+1]).
                int correction = 0;
                for (uint i = 0u; i < 32u; ++i) {
                    correction += sc[2u * lane + (i >> 4u)]
                        * input_q8[32u * lane + i];
                }
                dot -= correction << 5;
                sum = fma(scale, float(dot), sum);
            }
        }
        barrier();
    }
    partial_sums[invocation] = sum;
    barrier();
    if (lane != 0u || !valid_row) return;
    precise float result = 0.0;
    if (pc.input_sum_word != 0u) {
        for (uint i = 0u; i < 8u; i++) result += partial_sums[invocation + i];
    } else {
        result = ((partial_sums[invocation] + partial_sums[invocation + 4u])
        + (partial_sums[invocation + 1u] + partial_sums[invocation + 5u]))
        + ((partial_sums[invocation + 2u] + partial_sums[invocation + 6u])
        + (partial_sums[invocation + 3u] + partial_sums[invocation + 7u]));
    }
    uint output_word = slot == 0u ? pc.output0_word : (slot == 1u ? pc.output1_word : pc.output2_word);
    uint output_stride = slot == 0u ? pc.output0_stride : (slot == 1u ? pc.output1_stride : pc.output2_stride);
    arena.data[output_word + token_row * output_stride + row] = floatBitsToUint(result);
}
